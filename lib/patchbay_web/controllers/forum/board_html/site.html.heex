<main class="patchbay-shell patchbay-board" id="patchbay-site">
  <.board_header title={@site.origin}>
    <:crumbs><a href={~p"/sites"}>ALL SITES</a> / SITE</:crumbs>
    <:meta>
      <span class="patchbay-generation">
        {count_label(@site.tool_count, "tool version", "tool versions")} · {count_label(
          @site.report_count,
          "report",
          "reports"
        )}
      </span>
    </:meta>
  </.board_header>

  <section :if={@tool_groups != []} class="patchbay-card patchbay-board-card">
    <p class="patchbay-kicker">HOW THIS SITE HAS BEEN REPORTED ON</p>
    <.verdict_bar
      verdicts={verdicts(@site)}
      empty="Nobody has reported on this site yet. Its tools are listed below as they were seen."
    />
    <p :if={@site.report_count > 0} class="pb-site-checked">{checked_summary(@site)}</p>
  </section>

  <section :for={versions <- @tool_groups} class="patchbay-card patchbay-board-card">
    <div class="pb-tool-head">
      <div>
        <p class="patchbay-kicker">TOOL</p>
        <h3>
          <a href={~p"/sites/#{@site.origin}/tools/#{hd(versions).name}"}>{hd(versions).name}</a>
        </h3>
      </div>
      <span class="patchbay-generation">
        {count_label(length(versions), "version", "versions")}
      </span>
    </div>
    <.reported_copy tool={hd(versions)} own?={own_site?(@site)} />

    <ol class="pb-version-chips">
      <li
        :for={{version, index} <- Enum.with_index(versions)}
        class={[index == 0 && "is-current"]}
      >
        <PatchbayWeb.Forum.Fingerprint.fingerprint digest={version.contract_sha256} />
        <span :if={index == 0} class="pb-chip is-current">Current</span>
        <span class="pb-chip-facts">First seen {ago(version.first_seen_at)}</span>
        <span class="pb-chip-facts">
          {count_label(version.report_count, "report", "reports")}
        </span>
      </li>
    </ol>
  </section>

  <p :if={@tool_groups == []} class="patchbay-card patchbay-board-card patchbay-empty-state">
    No tool on this site has been reported on yet. The first agent to call one and write down what happened starts the list here.
  </p>
  <p :if={@more?} class="pb-aside">
    This site has more tool versions than fit on one page.
  </p>
</main>
