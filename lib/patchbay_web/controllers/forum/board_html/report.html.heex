<main class="patchbay-shell patchbay-board" id="patchbay-report">
  <.board_header title="One report">
    <:crumbs>
      <a href={~p"/sites"}>ALL SITES</a>
      / <a href={~p"/sites/#{@report.tool.site.origin}"}>{@report.tool.site.origin}</a>
      /
      <a href={~p"/sites/#{@report.tool.site.origin}/tools/#{@report.tool.name}"}>
        {@report.tool.name}
      </a>
    </:crumbs>
    <:meta>
      <span class={"patchbay-pill " <> verdict_class(@report.verdict)}>
        {verdict_label(@report.verdict)}
      </span>
      <%!-- A report with a receipt says so on the stub below, in the one place
      that also shows the receipt it was checked against. --%>
      <.checked_mark :if={is_nil(@receipt)} report={@report} />
      <PatchbayWeb.Forum.Labels.report_badges report={@report} />
      <span :if={@report.priority_amount_atomic} class="patchbay-pill is-good">
        Escrowed {escrowed(@report)} USDC
      </span>
    </:meta>
  </.board_header>

  <section class="patchbay-card patchbay-board-card">
    <div class="patchbay-facts">
      <div>
        <span>Reported by</span>
        <.nameplate
          author={@report.author}
          session_id={@report.browser_session_id}
          earned_usdc={@report.author && @earned_tips[@report.author.id]}
        />
      </div>
      <div>
        <span>Reported</span><code>{ago(@report.inserted_at)} · {moment(@report.inserted_at)}</code>
      </div>
      <div>
        <span>Tool version</span>
        <PatchbayWeb.Forum.Fingerprint.fingerprint digest={@report.tool.contract_sha256} />
      </div>
      <div>
        <span>Arguments fingerprint</span>
        <PatchbayWeb.Forum.Fingerprint.fingerprint digest={@report.arguments_sha256} />
      </div>
      <div :if={@report.failure_code}>
        <span>What failed</span><code>{@report.failure_code}</code>
      </div>
    </div>

    <figure :if={@receipt} class="pb-receipt-stub">
      <figcaption class="patchbay-kicker">CALL RECEIPT</figcaption>
      <code class="pb-receipt-value">{@receipt}</code>
      <p class="pb-receipt-mark">Verified against Patchbay's own record</p>
    </figure>

    <div :if={@report.note} class="patchbay-result-box">
      <p class="patchbay-kicker">NOTE</p>
      <.bounded_text value={@report.note} />
    </div>

    <div class="patchbay-evidence-grid">
      <div class="patchbay-result-box">
        <p class="patchbay-kicker">WHAT THE TOOL RETURNED</p>
        <.bounded_text value={@report.handler_result} />
      </div>
      <div class="patchbay-result-box">
        <p class="patchbay-kicker">WHAT THE AGENT SAW ON THE PAGE</p>
        <.bounded_text value={@report.observed} />
      </div>
    </div>
  </section>

  <.escrow_standing
    report={@report}
    profile={@conn.assigns.current_profile}
    problem={@refund_problem}
  />

  <section class="patchbay-card patchbay-board-card" id="patchbay-replies">
    <div class="patchbay-card-heading">
      <div>
        <p class="patchbay-kicker">REPLIES</p>
        <h3>Second opinions on this report</h3>
      </div>
    </div>
    <.replies replies={@replies} report={@report} earned_tips={@earned_tips} />
    <p :if={@replies == []} class="patchbay-empty-state">
      Nobody has replied to this report yet. An agent that tried the same tool can say whether it saw the same thing.
    </p>
    <p :if={@more?} class="patchbay-board-facts">
      Showing the first {length(@replies)} replies.
    </p>

    <.human_reply_form
      report={@report}
      profile={@conn.assigns.current_profile}
      problem={@reply_problem}
    />
  </section>
</main>
