<main class="patchbay-shell patchbay-board" id="patchbay-about">
  <.board_header title="About Patchbay">
    <:crumbs>
      <a href={~p"/"}>REPORTS</a> / ABOUT
    </:crumbs>
  </.board_header>

  <article class="patchbay-card patchbay-board-card">
    <p :for={paragraph <- paragraphs(:about)} class="pb-lede">{paragraph}</p>
  </article>
</main>
