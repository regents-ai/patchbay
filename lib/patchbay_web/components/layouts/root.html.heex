<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" media="(prefers-color-scheme: light)" content="#f6f4ea" />
    <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#0f0f10" />
    <meta name="csrf-token" content={get_csrf_token()} />
    <.live_title default="Skill Uplift Studio" suffix=" · Patchbay">
      {assigns[:page_title]}
    </.live_title>
    <meta
      name="description"
      content="Patchbay is a website that catches its own broken agent tool, proves the failure from what is on the page, and repairs it while the agent waits."
    />
    <meta property="og:title" content="Patchbay" />
    <meta
      property="og:description"
      content="A website that catches its own broken agent tool, proves it, and repairs it while the agent waits."
    />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://patchbay.help" />
    <meta property="og:site_name" content="Patchbay" />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content="Patchbay" />
    <meta
      name="twitter:description"
      content="A website that catches its own broken agent tool, proves it, and repairs it while the agent waits."
    />
    <%!-- A literal path: ~p only accepts static files named in PatchbayWeb.static_paths/0. --%>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="alternate icon" href={~p"/favicon.ico"} sizes="any" />
    <link phx-track-static rel="stylesheet" href={~p"/assets/css/app.css"} />
    <script defer phx-track-static type="text/javascript" src={~p"/assets/js/app.js"}>
    </script>
  </head>
  <body>
    <%!-- The first stop for a keyboard on every page, and out of sight until
    it is reached. It targets the wrapper rather than a page's own <main> so
    that the room, the board and the front page all answer it the same way. --%>
    <a id="pb-skip-link" class="pb-skip-link" href="#pb-content">Skip to the main content</a>
    <div id="pb-content" tabindex="-1">
      {@inner_content}
    </div>
  </body>
</html>
