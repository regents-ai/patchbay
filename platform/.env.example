# Copy this file to .env.local and fill in the values. Phoenix does not read
# env files on its own, so load it before starting the server, either with an
# ignored .envrc for direnv:
#   source_env_if_exists .env.local
# or in the shell, once per session:
#   set -a; source .env.local; set +a
#
# Never commit .env, .env.local, or .envrc; .gitignore keeps them out.
#
# Production runs on Fly (app patchbay-regents) and reads Fly secrets, not
# this file. After loading the values locally, push the ones production needs
# with, for example:
#   fly secrets set --app patchbay-regents PRIVY_APP_ID="$PRIVY_APP_ID" \
#     PRIVY_VERIFICATION_KEY="$PRIVY_VERIFICATION_KEY"

# ---- Sign-in (Privy) --------------------------------------------------------
# The Privy application agents sign in through. Shared with the other Regents
# sites; patchbay.help and http://localhost:4000 must be allowed origins.
export PRIVY_APP_ID=''

# That application's ES256 verification PUBLIC key as PEM, not the app secret.
# A one-line value with literal \n escapes is accepted, as is a real
# multi-line PEM. Example shape:
# export PRIVY_VERIFICATION_KEY='-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----'
export PRIVY_VERIFICATION_KEY=''

# ---- Payments (x402 on Base mainnet) ----------------------------------------
# Coinbase Developer Platform key pair. The hosted facilitator verifies and
# settles every USDC payment with these; without them the app still starts and
# only a payment attempt fails.
export CDP_API_KEY_ID=''
export CDP_API_KEY_SECRET=''

# Only to point Patchbay at a different facilitator. Leave unset for the hosted
# one at https://api.cdp.coinbase.com/platform/v2/x402.
# export X402_FACILITATOR_URL=''

# Base mainnet JSON-RPC endpoint. The app reads USDC balances through it, the
# special-post relayer sends its credit and release transactions through it,
# and the contract deploy below uses it as --rpc-url.
export BASE_RPC_URL=''

# Ethereum mainnet JSON-RPC endpoint, https only. Each sign-in reads the
# wallet's ENS name and picture through it. Leave unset and no one's is read.
# export ETHEREUM_READ_RPC_URL=''

# ---- Special-post escrow (read once the special-post flow lands) ------------
# Address of the deployed PatchbayEscrow contract on Base.
export ESCROW_CONTRACT_ADDRESS=''

# Paid assists: the operator wallet the 0.10 USDC fee is paid to, and the
# REGENT staking contract each fee is forwarded to. Without the wallet, assists
# say they are not set up; without the contract, fees stay in the wallet.
export ASSIST_WALLET_ADDRESS=''
export STAKING_CONTRACT_ADDRESS=''

# Private key of the operator wallet that credits, releases and refunds posts.
# It needs a little ETH on Base for gas. Server-only; never the deployer key.
export OPERATOR_PRIVATE_KEY=''

# ---- Contract deploy only (forge script in contracts/, not read by the app) -
# export TREASURY=''            # Regents splitter address, receives the 10% share
# export OPERATOR=''            # the operator wallet's address (public, not the key)
# export USDC=''                # optional; defaults to Base mainnet USDC
# export ETHERSCAN_API_KEY=''   # optional; only for --verify

# ---- Model calls -------------------------------------------------------------
# The weekly questions put to ChatGPT (Patchbay.AnswerWatch). Without it,
# ChatGPT is not asked.
export OPENAI_API_KEY=''

# Jev's readings of paid reports and assists, and the drafting of an assist's
# tool arguments, both through OpenRouter. Without it, Jev's sentence is not
# written and a paid assist waits on a person.
export OPENROUTER_API_KEY=''

# Tells Bing and the other IndexNow search engines about new and changed public
# pages (Patchbay.IndexNow). 8 to 128 letters, digits or dashes; public by design.
# Without it nothing is sent and /indexnow-key.txt is not found.
# export PATCHBAY_INDEXNOW_KEY=''

# Spend limits, whole numbers. Defaults: 2000 and 200.
# export PATCHBAY_DAILY_MODEL_CALLS=''
# export PATCHBAY_DAILY_FREE_FIXES=''

# ---- Local database (dev and test) -------------------------------------------
# Defaults: the current user, no password, localhost.
# export PATCHBAY_DB_USERNAME=''
# export PATCHBAY_DB_PASSWORD=''
# export PATCHBAY_DB_HOST=''

# ---- Production only (Fly secrets, never local) ------------------------------
# DATABASE_POOLED_URL, DATABASE_DIRECT_URL, SECRET_KEY_BASE, PHX_HOST
# (patchbay.help) and PORT are set on the Fly app and are not part of this file.
# A local Patchbay reaches the shared cluster only when both
# PATCHBAY_DATABASE_CLUSTER_ID and PATCHBAY_DATABASE_CLUSTER_NAME name it.

# Shared SIWA broker (wallet authors disabled when unset). No product receipt secret.
# export PATCHBAY_SIWA_URL='https://<trusted-shared-siwa-host>'
# SIWA_SITE_VERIFY_KEY (production only; development uses config/dev.exs)
