<main class="pb-incident" id="patchbay-incidents">
  <header class="pb-incident-head">
    <h1>Incidents</h1>
  </header>

  <PatchbayWeb.PaidOffers.paid_offers offers={@offers} />

  <section class="pb-incident-section" id="patchbay-cves" aria-labelledby="patchbay-cves-title">
    <header class="pb-incident-section-head">
      <h2 id="patchbay-cves-title">Critical CVEs</h2>
      <p class="pb-incident-meta">
        From <a href="https://cve.now" target="_blank" rel="noopener noreferrer">cve.now</a>
      </p>
    </header>

    <p :if={@cves == :unavailable} class="pb-incident-meta">
      Critical CVEs could not be read just now.
    </p>
    <p :if={@cves != :unavailable and @cves.posts == []} class="pb-incident-meta">
      No critical CVEs yet.
    </p>

    <ol :if={@cves != :unavailable and @cves.posts != []} class="pb-incident-list">
      <li :for={post <- @cves.posts} class="pb-incident-row">
        <a class="pb-incident-row-title" href={PostAddress.path(post)}>{post.title}</a>
        <p class="pb-incident-meta">
          <span>Posted {day(post.inserted_at)}</span>
          <a href={PostAddress.path(post) <> "#patchbay-replies"}>
            {replies_label(post.reply_count)}
          </a>
        </p>
      </li>
    </ol>

    <nav
      :if={@cves != :unavailable and @cves.pages > 1}
      class="pb-incident-pages"
      aria-label="Critical CVE pages"
    >
      <a
        :if={@page > 1}
        href={if @page == 2, do: ~p"/incidents", else: ~p"/incidents?#{[page: @page - 1]}"}
        rel="prev"
      >← Newer</a>
      <span>Page {@page} of {@cves.pages}</span>
      <a :if={@page < @cves.pages} href={~p"/incidents?#{[page: @page + 1]}"} rel="next">
        Older →
      </a>
    </nav>
  </section>

  <section
    :if={@page == 1}
    class="pb-incident-section"
    id="patchbay-briefings"
    aria-labelledby="patchbay-briefings-title"
  >
    <header class="pb-incident-section-head">
      <h2 id="patchbay-briefings-title">Briefings</h2>
    </header>

    <ol class="pb-incident-list">
      <li :for={incident <- @incidents} class="pb-incident-row">
        <a class="pb-incident-row-title" href={incident_path(incident)}>{incident.title}</a>
        <p class="pb-incident-meta">
          <.status_pill incident={incident} />
          <span>Checked {day(incident.checked)}</span>
          <a :if={@replies != :unavailable} href={incident_path(incident) <> "#patchbay-replies"}>
            {replies_label(Map.get(@replies, incident.name, 0))}
          </a>
          <span :if={@replies == :unavailable}>Replies could not be counted just now</span>
        </p>
      </li>
    </ol>
  </section>
</main>
