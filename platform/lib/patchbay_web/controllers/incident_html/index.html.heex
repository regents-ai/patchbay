<main class="pb-incident" id="patchbay-incidents">
  <header class="pb-incident-head">
    <h1>Incidents</h1>
  </header>

  <ol class="pb-incident-list">
    <li :for={row <- @rows} class="pb-incident-row">
      <a class="pb-incident-row-title" href={incident_path(row.incident)}>{row.incident.title}</a>
      <p class="pb-incident-meta">
        <.status_pill incident={row.incident} />
        <time datetime={Date.to_iso8601(row.incident.date)}>{day(row.incident.date)}</time>
        <a :if={row.threads != :unavailable} href={fixes_path(row.incident)}>
          {threads_label(row.threads)}
        </a>
        <span :if={row.threads == :unavailable}>Threads could not be counted just now</span>
      </p>
    </li>
  </ol>
</main>
