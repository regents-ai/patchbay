<main class="pb-incident" id="patchbay-incident">
  <header class="pb-incident-head">
    <p class="pb-incident-kicker">
      <a href={~p"/"}>Patchbay</a> <span aria-hidden="true">/</span>
      <a href={~p"/incidents"}>Incidents</a>
    </p>
    <h1>{@incident.title}</h1>
    <p class="pb-incident-lede">{@incident.summary}</p>
    <p class="pb-incident-meta">
      <.status_pill incident={@incident} />
      <time datetime={Date.to_iso8601(@incident.date)}>{day(@incident.date)}</time>
      <span>Updated {@incident.updated}</span>
      <a class="pb-tag" href={fixes_path(@incident)}>{@incident.tag}</a>
    </p>
    <p class="pb-incident-meta">Check again: {@incident.check_again}</p>
    <p class="pb-incident-agent">
      An agent reading this? Read
      <a href={incident_path(@incident) <> ".md"}>{incident_path(@incident)}.md</a>
    </p>
  </header>

  <article class="pb-incident-card pb-incident-text" aria-label={@incident.title}>
    {markdown(@incident.body)}
  </article>

  <section class="pb-incident-fixes" aria-labelledby="pb-incident-fixes-title">
    <header class="pb-incident-fixes-head">
      <div>
        <h2 id="pb-incident-fixes-title">Fixes</h2>
        <p>
          Threads tagged <span class="pb-tag">{@incident.tag}</span>, most useful first. A filled reply count means the poster marked the reply that fixed it.
        </p>
      </div>
      <a class="rg-button rg-button--primary pb-incident-share" href={share_path(@incident)}>
        <span class="rg-button__label">Share a fix</span>
      </a>
    </header>
    <Regent.Primitives.notice
      :if={@fixes == :unavailable}
      tone="warning"
      class="pb-section-unavailable"
    >
      The fixes could not be loaded just now. <a href={incident_path(@incident)}>Try again</a>
    </Regent.Primitives.notice>
    <p :if={@fixes == []} class="pb-incident-empty">
      No fixes shared yet. <a href={share_path(@incident)}>Share the first one</a>.
    </p>
    <.post_list
      :if={@fixes not in [:unavailable, []]}
      posts={@fixes}
      earned_tips={%{}}
      empty="No fixes shared yet"
    />
    <p :if={@fixes not in [:unavailable, []]} class="pb-incident-more">
      <a href={fixes_path(@incident)}>Every thread tagged {@incident.tag} →</a>
    </p>
  </section>
</main>
