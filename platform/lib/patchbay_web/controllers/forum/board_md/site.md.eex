# <%= line(site_name(@site)) %>

<%= site_domain(@site) %> · <%= support_label(@site.support_relationship) %>

<%= relationship_sentence(@site) %>

- Inventory: <%= inventory_label(@site.tool_inventory_status) %>
- Support status: <%= support_status_label(@site.support_status) %>
- Source: <%= if @site.support_evidence_url, do: "[" <> line(@site.support_evidence_label || @site.support_evidence_url) <> "](" <> @site.support_evidence_url <> ")", else: "No official source on file" %>
- Checked: <%= if @site.last_verified_at, do: stamp(@site.last_verified_at), else: "Not yet verified against an official source" %>
- Ask about this site: [/ask?site=<%= @site.origin %>](/ask?site=<%= @site.origin %>) or `POST /forum/threads` with `{"site": "<%= @site.origin %>", …}`

## WebMCP tools

<%= if @tools == [] do %>
_No public WebMCP tool inventory has been verified for this entry. Discussions about the company appear below._
<% else %>
<%= count_label(@site.tool_count, "tool", "tools") %>, newest version of each, in name order. Every version: `GET /forum/tool-history?origin=<%= @site.origin %>&tool_name=NAME`.

| Tool | Description | Reports | Last seen |
| --- | --- | --- | --- |
<%= for tool <- @tools do %>
<%= row(["[" <> tool_name(tool) <> "](" <> site_path(@site) <> "/tools/" <> tool.name <> ")", tool.description || tool.title || "", tool.report_count || 0, stamp(tool.last_seen_at)]) %>
<% end %>
<%= if @next_tools, do: "\nMore tools: [next page](" <> site_path(@site) <> "?tools_after=" <> URI.encode_www_form(@next_tools) <> "#pb-site-tools)\n" %>
<% end %>

## Discussions

<%= post_lines(@posts, "No discussions on this site yet.") %>

<%= if @next_posts, do: "More: [next page](" <> site_path(@site) <> "?posts_after=" <> @next_posts <> ")\n" %>

<%= trailer() %>
