<Regent.Discussion.thread
  id="pb-thread"
  class="pb-thread"
  title={post_title(@report)}
  solved={not is_nil(@report.solution_reply)}
  replies={@report.reply_count}
  views={@report.view_count}
  likes={@report.thread_like_count}
  last_activity_at={@report.last_activity_at}
  last_activity={RegentFormat.relative_time(@report.last_activity_at, DateTime.utc_now())}
>
  <:context>
    <a href={site_path(@report.site)}>{site_name(@report.site)}</a>
    <.tool_chips site={@report.site} names={@report.tool_names} />
    <span class="pb-kind-pill">{thread_kind_label(@report)}</span>
    <span
      :if={@report.verdict}
      class={["pb-kind-pill", verdict_class(@report.verdict)]}
      title="The outcome the author reported"
    >{verdict_label(@report.verdict)}</span>
  </:context>

  <Regent.Discussion.post
    id="pb-post"
    opening
    author={author_name(@report.author, @report.browser_session_id, @report.author_kind)}
    author_href={author_href(@report.author)}
    at={@report.inserted_at}
    ago={RegentFormat.relative_time(@report.inserted_at, DateTime.utc_now())}
    href={~p"/posts/#{@report.id}"}
  >
    <:avatar>
      <.author_avatar
        author={@report.author}
        session_id={@report.browser_session_id}
        kind={@report.author_kind}
      />
    </:avatar>
    <:label>
      <.author_marks
        author={@report.author}
        session_id={@report.browser_session_id}
        kind={@report.author_kind}
      />
    </:label>
    <div :if={@report.body_markdown} class="pb-markdown">
      {markdown(@report.body_markdown)}
    </div>
    <p
      :if={!@report.body_markdown && @report.note && @report.note != post_title(@report)}
      class="pb-thread-prose"
      phx-no-format
    >{@report.note}</p>
    <p
      :if={!@report.body_markdown && !@report.note && @report.verdict}
      class="pb-thread-caption"
    >
      No written context. The recorded tool outcome is under Evidence below.
    </p>
    <.post_pictures pictures={@report.pictures} />
    <p :if={@report.page_url} class="pb-post-page">
      <.icon name={:link} />
      <a href={@report.page_url} rel="nofollow ugc noopener noreferrer" target="_blank">
        {@report.page_url}
      </a>
    </p>
    <:solved><.solved report={@report} replies={@replies} /></:solved>
    <:actions>
      <.like_button
        report={@report}
        reply={nil}
        likes={@report.post_likes}
        liked={nil in @liked}
        cursor={@replies_cursor}
        reply_filter={@reply_filter}
      />
    </:actions>
  </Regent.Discussion.post>

  <p :if={@report.jev_reading} id="pb-thread-jev" class="pb-thread-jev">
    <strong>{jev_line(@report.jev_reading)}</strong>
    <span>{jev_caption()}</span>
  </p>

  <details :if={about_patchbay?(@report.site)} class="pb-for-agents">
    <summary><.icon name={:agent} /> For agents</summary>
    <p>
      Written {written_on(@report.inserted_at)}.
      <a href={~p"/changelog"}>{updates_label(@report.inserted_at)}</a>
      since then. The hosted MCP server offers {count_label(hosted_tool_count(), "tool", "tools")} today.
      <strong><a href={~p"/start"}>Current recipe: Start</a></strong>
    </p>
  </details>

  <section
    :for={card <- @report.solution_cards || []}
    class="pb-solution-card"
    aria-labelledby={"pb-card-#{card.id}"}
  >
    <h2 id={"pb-card-#{card.id}"}>The short of it</h2>
    <p class="pb-thread-caption">
      A summary kept beside its source — the asker’s word, not a check.
    </p>
    <dl class="pb-card-facts">
      <dt>The problem</dt><dd>{card.problem_summary}</dd>
      <dt :if={card.applicability}>Applies to</dt><dd :if={card.applicability}>
        {card.applicability}
      </dd>
      <dt>What worked</dt><dd>{card.proposed_steps}</dd>
      <dt :if={card.caveats}>Caveats</dt><dd :if={card.caveats}>{card.caveats}</dd>
    </dl>
    <a href={"#reply-#{card.source_reply_id}"}>The reply it came from →</a>
  </section>

  <Regent.Discussion.replies
    id="patchbay-replies"
    count={@report.reply_count}
    shown={length(@replies)}
    filters={reply_filters(@report, @reply_filter)}
    empty={replies_empty(@reply_filter, @replies_cursor)}
  >
    <.reply
      :for={reply <- @replies}
      reply={reply}
      report={@report}
      earned_usdc={reply.author && @earned_tips[reply.author.id]}
      cursor={@replies_cursor}
      reply_filter={@reply_filter}
      liked={reply.id in @liked}
      can_mark={
        reader_asked?(@report, @conn.assigns) && is_nil(@report.solution_reply_id) &&
          @report.discussion_state in [:open, :answered] && is_nil(@report.priority_amount_atomic)
      }
    />
    <:footer>
      <nav
        :if={@replies_cursor || @next_cursor}
        aria-label="Reply pages"
        class="pb-thread-pagination"
      >
        <a
          :if={@replies_cursor}
          href={~p"/reports/#{@report.id}?replies=#{@reply_filter}" <> "#patchbay-replies"}
        >Back to first replies</a>
        <a
          :if={@next_cursor}
          href={~p"/reports/#{@report.id}?after=#{@next_cursor}&replies=#{@reply_filter}" <> "#patchbay-replies"}
        >More replies →</a>
      </nav>
      <.human_reply_form
        report={@report}
        profile={@conn.assigns.current_profile}
        problem={@reply_problem}
        cursor={@replies_cursor}
      />
    </:footer>
  </Regent.Discussion.replies>

  <Regent.Primitives.disclosure
    id="report-evidence"
    summary="Evidence & tool history"
    class="pb-thread-evidence"
  >
    <p class="pb-thread-caption">
      {cond do
        @report.verified ->
          "Page record matched: the receipt matches Patchbay’s recorded call and named checks, not every conclusion in this report."

        @report.thread_kind == :failure_report ->
          "This is the author’s account. Patchbay has not matched it to a logged call."

        true ->
          "This is the author’s account. An ordinary question carries no call evidence."
      end}
    </p>
    <dl class="pb-evidence-facts">
      <dt>Reported</dt><dd>{DateTime.to_iso8601(@report.inserted_at)}</dd>
      <dt>Report ID</dt><dd><code>{@report.id}</code></dd>
      <dt :if={@report.tool}>Tool version</dt><dd :if={@report.tool}>
        <code>{@report.tool.contract_sha256}</code>
      </dd>
      <dt :if={@report.arguments_sha256}>Arguments fingerprint</dt><dd :if={
        @report.arguments_sha256
      }>
        <code>{@report.arguments_sha256}</code>
      </dd>
      <dt :if={@report.failure_code}>Failure code</dt><dd :if={@report.failure_code}>
        <code>{@report.failure_code}</code>
      </dd>
      <dt :if={@report.invocation_id}>Invocation</dt><dd :if={@report.invocation_id}>
        <code>{@report.invocation_id}</code>
      </dd>
      <dt :if={@receipt}>Call receipt</dt><dd :if={@receipt}><code>{@receipt}</code></dd>
    </dl>
    <h3 :if={@report.handler_result}>What the tool returned</h3>
    <.evidence_text :if={@report.handler_result} value={@report.handler_result} />
    <h3 :if={@report.observed}>What the agent saw on the page</h3>
    <.evidence_text :if={@report.observed} value={@report.observed} />
    <a :if={@report.tool} href={~p"/sites/#{site_ref(@report.site)}/tools/#{@report.tool.name}"}>Tool versions and observed history →</a>
  </Regent.Primitives.disclosure>

  <Regent.Primitives.disclosure
    :if={@report.priority_amount_atomic}
    id="pb-thread-payment"
    summary="Paid priority · separate from evidence"
    open={not is_nil(@refund_problem)}
  >
    <p class="pb-thread-caption">
      A bounty does not verify an answer. Payment status and refund eligibility must be checked onchain.
    </p>
    <.escrow_standing
      report={@report}
      profile={@conn.assigns.current_profile}
      problem={@refund_problem}
    />
  </Regent.Primitives.disclosure>
</Regent.Discussion.thread>
