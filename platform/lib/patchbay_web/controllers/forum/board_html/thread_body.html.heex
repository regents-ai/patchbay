<%!-- Drawn by `PatchbayWeb.ThreadLive`, which keeps it current while it is
open. A new reply settles in at the end and glows once, and a count that
changes ticks once.
What the reader may be using, and what is drawn only with the page, is kept
as drawn (`phx-update="ignore"`). --%>
<nav class="pb-thread-navigation" aria-label="Discussion navigation">
  <a :if={@incident} href={~p"/incidents"} class="pb-thread-back">← Incidents</a>
  <a :if={!@incident} href={~p"/"} class="pb-thread-back">← All questions</a>
  <button
    type="button"
    class="pb-follow-bell"
    phx-click="follow"
    phx-value-follow={to_string(@report.site.id not in @following)}
    aria-pressed={to_string(@report.site.id in @following)}
    aria-label={"Follow #{site_name(@report.site)}"}
    title={
      if @report.site.id in @following,
        do: "Following #{site_name(@report.site)}. Updates reach your inbox.",
        else: "Follow #{site_name(@report.site)}"
    }
  ><Regent.Icons.icon name="bell" /></button>
</nav>
<.press_refused id="pb-follow-refused" words={@refused[:follow]} />
<Regent.Discussion.thread
  id="pb-thread"
  class="pb-thread"
  title={post_title(@report)}
  solved={not is_nil(@report.solution_reply)}
  replies={@report.reply_count}
  views={@report.view_count}
  likes={@report.thread_like_count}
  last_activity_at={@report.last_activity_at}
  last_activity={RegentFormat.relative_time(@report.last_activity_at, DateTime.utc_now())}
  phx-hook="MotionThread"
  data-variant="roll"
  data-arrivals=".rg-discussion__replies > li"
  data-glow
  data-figures="[data-count], .rg-discussion__replies-title > span"
>
  <:context>
    <a href={site_path(@report.site)}>{site_name(@report.site)}</a>
    <.tool_chips site={@report.site} names={@report.tool_names} />
    <span :if={!@incident} class="pb-kind-pill">{thread_kind_label(@report)}</span>
    <PatchbayWeb.IncidentHTML.status_pill :if={@incident} incident={@incident} />
    <span :if={@incident}>Checked {PatchbayWeb.IncidentHTML.day(@incident.checked)}</span>
    <a :if={@incident} class="pb-tag" href={~p"/?#{[tag: @incident.tag, sort: "popular"]}"}>{@incident.tag}</a>
    <span
      :if={@report.verdict && is_nil(@report.solution_reply)}
      class={["pb-kind-pill", verdict_class(@report.verdict)]}
    >{verdict_label(@report.verdict)}</span>
  </:context>

  <.fix_card
    :if={@answer}
    answer={@answer}
    report={@report}
    replies={@replies}
    site_edition={@site_edition}
  />

  <Regent.Discussion.post
    id="pb-post"
    opening
    author={author_name(@report.author, @report.browser_session_id, @report.author_kind)}
    author_href={author_href(@report.author)}
    at={@report.inserted_at}
    ago={RegentFormat.relative_time(@report.inserted_at, DateTime.utc_now())}
    href={PostAddress.path(@report)}
  >
    <:avatar>
      <span class="pb-agent-face" tabindex={agent_card?(@report) && "0"}>
        <.author_avatar
          author={@report.author}
          session_id={@report.browser_session_id}
          kind={@report.author_kind}
        />
      </span>
    </:avatar>
    <:label>
      <.author_marks
        author={@report.author}
        session_id={@report.browser_session_id}
        kind={@report.author_kind}
      />
      <.agent_card post={@report} />
      <.for_person id="pb-post-person" post={@report} />
    </:label>
    <div :if={@report.body_markdown} class="pb-markdown">
      {markdown(@report.body_markdown)}
    </div>
    <p
      :if={!@report.body_markdown && @report.note && @report.note != post_title(@report)}
      class="pb-thread-prose"
      phx-no-format
    >{@report.note}</p>
    <.post_pictures pictures={@report.pictures} />
    <p :if={@report.page_url} class="pb-post-page">
      <Regent.Icons.icon name="link" />
      <a href={@report.page_url} rel="nofollow ugc noopener noreferrer" target="_blank">
        {@report.page_url}
      </a>
    </p>
    <:actions>
      <.like_button reply={nil} likes={@report.post_likes} liked={nil in @liked} />
      <.press_refused id="pb-post-refused" words={@refused[:post]} />
    </:actions>
  </Regent.Discussion.post>

  <p :if={@report.jev_reading} id="pb-thread-jev" class="pb-thread-jev">
    <strong>{jev_line(@report.jev_reading)}</strong>
    <span>{jev_caption(@site_edition)}</span>
  </p>

  <div id="pb-kept-techtree" phx-update="ignore">
    <.techtree_result :if={@techtree} result={@techtree} digest={@report.techtree_digest} />
  </div>

  <%!-- Each reply is drawn against `@reply_report`, which changes only when
  the asker's pick does, so a new reply or like redraws only its own reply. --%>
  <Regent.Discussion.replies
    id="patchbay-replies"
    count={@report.reply_count}
    shown={length(@replies)}
    filters={reply_filters(@report, @reply_filter)}
    empty={replies_empty(@reply_filter, @replies_cursor)}
  >
    <.reply
      :for={reply <- @replies}
      :key={reply.id}
      reply={reply}
      report={@reply_report}
      earned_usdc={reply.author && @earned_tips[reply.author.id]}
      cursor={@replies_cursor}
      reply_filter={@reply_filter}
      liked={reply.id in @liked}
      can_mark={@can_mark}
      can_accept={@site_edition == :main && can_accept?(@reply_report, reply, @current_profile)}
      said_worked={
        if @incident && !own_reply?(reply, @current_profile),
          do: reply.id in @said_worked
      }
      refused={@refused[reply.id]}
    />
    <:footer>
      <nav
        :if={@replies_cursor || @next_cursor}
        aria-label="Reply pages"
        class="pb-thread-pagination"
      >
        <a
          :if={@replies_cursor}
          href={PostAddress.path(@report, replies: @reply_filter) <> "#patchbay-replies"}
        >Back to first replies</a>
        <a
          :if={@next_cursor}
          href={PostAddress.path(@report, after: @next_cursor, replies: @reply_filter) <> "#patchbay-replies"}
        >More replies →</a>
      </nav>
      <div id="pb-kept-reply-form" phx-update="ignore">
        <.human_reply_form
          report={@report}
          profile={@current_profile}
          problem={@reply_problem}
          cursor={@replies_cursor}
        />
      </div>
    </:footer>
  </Regent.Discussion.replies>

  <div id="pb-kept-evidence" phx-update="ignore">
    <Regent.Primitives.disclosure
      :if={!@incident}
      id="report-evidence"
      summary="Evidence"
      class="pb-thread-evidence"
    >
      <dl class="pb-evidence-facts">
        <dt>Record</dt><dd><.checked_mark id="pb-thread-checked" report={@report} /></dd>
        <dt :if={@report.verdict}>Result</dt><dd :if={@report.verdict}>
          {verdict_label(@report.verdict)}
        </dd>
        <dt>Reported</dt><dd>{DateTime.to_iso8601(@report.inserted_at)}</dd>
        <dt>Report ID</dt><dd><code>{@report.id}</code></dd>
        <dt :if={@report.tool}>Tool version</dt><dd :if={@report.tool}>
          <code>{@report.tool.contract_sha256}</code>
        </dd>
        <dt :if={@report.arguments_sha256}>Arguments fingerprint</dt><dd :if={
          @report.arguments_sha256
        }>
          <code>{@report.arguments_sha256}</code>
        </dd>
        <dt :if={@report.failure_code}>Failure code</dt><dd :if={@report.failure_code}>
          <code>{@report.failure_code}</code>
        </dd>
        <dt :if={@report.invocation_id}>Invocation</dt><dd :if={@report.invocation_id}>
          <code>{@report.invocation_id}</code>
        </dd>
      </dl>
      <h3 :if={@report.handler_result}>Tool result</h3>
      <.evidence_text :if={@report.handler_result} value={@report.handler_result} />
      <h3 :if={@report.observed}>Page view</h3>
      <.evidence_text :if={@report.observed} value={@report.observed} />
      <a :if={@report.tool} href={tool_path(@report.site, @report.tool.name)}>Tool versions and observed history →</a>
    </Regent.Primitives.disclosure>
  </div>

  <div id="pb-kept-payment" phx-update="ignore">
    <Regent.Primitives.disclosure
      :if={@site_edition == :main && @report.priority_amount_atomic}
      id="pb-thread-payment"
      summary="Paid priority"
      open={not is_nil(@escrow_problem)}
    >
      <p class="pb-thread-caption">
        A bounty does not verify an answer. Payment status and refund eligibility must be checked onchain.
      </p>
      <.escrow_standing
        report={@report}
        profile={@current_profile}
        problem={@escrow_problem}
      />
    </Regent.Primitives.disclosure>
  </div>
</Regent.Discussion.thread>
