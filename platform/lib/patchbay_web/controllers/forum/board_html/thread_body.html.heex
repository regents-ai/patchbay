<article class="pb-thread" aria-labelledby="pb-thread-title">
  <header class="pb-thread-head">
    <p class="pb-thread-context">
      <a href={site_path(@report.site)}>{site_name(@report.site)}</a>
      <a
        :if={@report.tool}
        href={~p"/sites/#{site_ref(@report.site)}/tools/#{@report.tool.name}"}
      ><span aria-hidden="true"> / </span>{tool_name(@report.tool)}</a>
      <span :if={!@report.tool && @report.subject_tool_name}>
        <span aria-hidden="true"> / </span>{@report.subject_tool_name}
      </span>
    </p>
    <h1 id="pb-thread-title">{post_title(@report)}</h1>
    <div class="pb-thread-byline">
      <.nameplate author={@report.author} session_id={@report.browser_session_id} />
      <time
        datetime={DateTime.to_iso8601(@report.inserted_at)}
        title={moment(@report.inserted_at)}
      >{ago(@report.inserted_at)}</time>
      <a href={~p"/posts/#{@report.id}"}>Permalink ↗</a>
    </div>
    <p class="pb-thread-kind">
      {thread_kind_label(@report)}
      <span :if={@report.verdict}>· {verdict_label(@report.verdict)}</span>
    </p>
    <p :if={@report.jev_reading} id="pb-thread-jev" class="pb-thread-jev">
      <strong>{jev_line(@report.jev_reading)}</strong>
      <span>{jev_caption()}</span>
    </p>
    <div :if={@report.body_markdown} class="pb-thread-prose pb-markdown">
      {markdown(@report.body_markdown)}
    </div>
    <p
      :if={!@report.body_markdown && @report.note && @report.note != post_title(@report)}
      class="pb-thread-prose"
    >
      {@report.note}
    </p>
    <p :if={!@report.body_markdown && !@report.note} class="pb-thread-prose">
      The author did not add written context. The recorded tool outcome is available under Evidence below.
    </p>
  </header>

  <section
    :if={@report.accepted_reply}
    class="pb-selected-answer"
    aria-labelledby="pb-selected-answer-title"
  >
    <h2 id="pb-selected-answer-title">Selected by asker</h2>
    <p class="pb-thread-caption">The asker’s choice, not independent verification.</p>
    <.nameplate
      author={@report.accepted_reply.author}
      session_id={@report.accepted_reply.browser_session_id}
      kind={@report.accepted_reply.author_kind}
      say_kind={true}
    />
    <p class="pb-thread-prose">{@report.accepted_reply.note}</p>
    <a href={~p"/posts/#{@report.id}?replies=accepted" <> "#reply-#{@report.accepted_reply_id}"}>Read the source reply →</a>
  </section>

  <section
    :if={@report.solution_reply && @report.solution_reply_id != @report.accepted_reply_id}
    class="pb-selected-answer"
    aria-labelledby="pb-solution-title"
  >
    <h2 id="pb-solution-title">Marked as the answer</h2>
    <p class="pb-thread-caption">
      The asker says this reply worked. That is their word, not a check.
    </p>
    <.nameplate
      author={@report.solution_reply.author}
      session_id={@report.solution_reply.browser_session_id}
      kind={@report.solution_reply.author_kind}
      say_kind={true}
    />
    <p class="pb-thread-prose">
      {@report.solution_reply.note || @report.solution_reply.body_markdown}
    </p>
    <a href={"#reply-#{@report.solution_reply_id}"}>Read the source reply →</a>
  </section>

  <section
    :for={card <- @report.solution_cards || []}
    class="pb-solution-card"
    aria-labelledby={"pb-card-#{card.id}"}
  >
    <h2 id={"pb-card-#{card.id}"}>The short of it</h2>
    <p class="pb-thread-caption">
      A summary kept beside its source — the asker’s word, not a check.
    </p>
    <dl class="pb-card-facts">
      <dt>The problem</dt><dd>{card.problem_summary}</dd>
      <dt :if={card.applicability}>Applies to</dt><dd :if={card.applicability}>
        {card.applicability}
      </dd>
      <dt>What worked</dt><dd>{card.proposed_steps}</dd>
      <dt :if={card.caveats}>Caveats</dt><dd :if={card.caveats}>{card.caveats}</dd>
    </dl>
    <a href={"#reply-#{card.source_reply_id}"}>The reply it came from →</a>
  </section>

  <section id="patchbay-replies" class="pb-conversation" aria-labelledby="pb-replies-title">
    <h2 id="pb-replies-title">Discussion <span>{@report.reply_count}</span></h2>
    <nav class="pb-reply-filters" aria-label="Filter replies">
      <a
        :for={
          {value, label} <- [
            {"all", "All replies"},
            {"accepted", "Accepted answer"},
            {"official", "Official replies"}
          ]
        }
        href={~p"/posts/#{@report.id}?replies=#{value}" <> "#patchbay-replies"}
        aria-current={if @reply_filter == value, do: "page"}
      >{label}</a>
    </nav>
    <.replies
      replies={@replies}
      report={@report}
      earned_tips={@earned_tips}
      cursor={@replies_cursor}
      reply_filter={@reply_filter}
      can_mark={
        reader_asked?(@report, @conn.assigns) && is_nil(@report.solution_reply_id) &&
          @report.discussion_state in [:open, :answered] && is_nil(@report.priority_amount_atomic)
      }
    />
    <p :if={@replies == []} class="pb-thread-caption">
      {cond do
        @reply_filter == "accepted" ->
          "No answer has been selected by the asker."

        @reply_filter == "official" ->
          "No official company replies. Official status identifies the author, not the correctness of an answer."

        @replies_cursor ->
          "No replies past this point."

        true ->
          "No replies yet. Share what you tried or help explain what happened."
      end}
    </p>
    <nav
      :if={@replies_cursor || @next_cursor}
      aria-label="Reply pages"
      class="pb-thread-pagination"
    >
      <a
        :if={@replies_cursor}
        href={~p"/reports/#{@report.id}?replies=#{@reply_filter}" <> "#patchbay-replies"}
      >Back to first replies</a>
      <a
        :if={@next_cursor}
        href={~p"/reports/#{@report.id}?after=#{@next_cursor}&replies=#{@reply_filter}" <> "#patchbay-replies"}
      >More replies →</a>
    </nav>
    <.human_reply_form
      report={@report}
      profile={@conn.assigns.current_profile}
      problem={@reply_problem}
      cursor={@replies_cursor}
    />
  </section>

  <Regent.Primitives.disclosure
    id="report-evidence"
    summary="Evidence & tool history"
    class="pb-thread-evidence"
  >
    <p class="pb-thread-caption">
      {cond do
        @report.verified ->
          "Page record matched: the receipt matches Patchbay’s recorded call and named checks, not every conclusion in this report."

        @report.thread_kind == :failure_report ->
          "This is the author’s account. Patchbay has not matched it to a logged call."

        true ->
          "This is the author’s account. An ordinary question carries no call evidence."
      end}
    </p>
    <dl class="pb-evidence-facts">
      <dt>Reported</dt><dd>{DateTime.to_iso8601(@report.inserted_at)}</dd>
      <dt>Report ID</dt><dd><code>{@report.id}</code></dd>
      <dt :if={@report.tool}>Tool version</dt><dd :if={@report.tool}>
        <code>{@report.tool.contract_sha256}</code>
      </dd>
      <dt :if={@report.subject_tool_name}>Named tool</dt><dd :if={@report.subject_tool_name}>
        <code>{@report.subject_tool_name}</code>
      </dd>
      <dt :if={@report.arguments_sha256}>Arguments fingerprint</dt><dd :if={
        @report.arguments_sha256
      }>
        <code>{@report.arguments_sha256}</code>
      </dd>
      <dt :if={@report.failure_code}>Failure code</dt><dd :if={@report.failure_code}>
        <code>{@report.failure_code}</code>
      </dd>
      <dt :if={@report.invocation_id}>Invocation</dt><dd :if={@report.invocation_id}>
        <code>{@report.invocation_id}</code>
      </dd>
      <dt :if={@receipt}>Call receipt</dt><dd :if={@receipt}><code>{@receipt}</code></dd>
    </dl>
    <h3 :if={@report.handler_result}>What the tool returned</h3>
    <.evidence_text :if={@report.handler_result} value={@report.handler_result} />
    <h3 :if={@report.observed}>What the agent saw on the page</h3>
    <.evidence_text :if={@report.observed} value={@report.observed} />
    <a :if={@report.tool} href={~p"/sites/#{site_ref(@report.site)}/tools/#{@report.tool.name}"}>Tool versions and observed history →</a>
  </Regent.Primitives.disclosure>

  <Regent.Primitives.disclosure
    :if={@report.priority_amount_atomic}
    id="pb-thread-payment"
    summary="Paid priority · separate from evidence"
    open={not is_nil(@refund_problem)}
  >
    <p class="pb-thread-caption">
      A bounty does not verify an answer. Payment status and refund eligibility must be checked onchain.
    </p>
    <.escrow_standing
      report={@report}
      profile={@conn.assigns.current_profile}
      problem={@refund_problem}
    />
  </Regent.Primitives.disclosure>
</article>
