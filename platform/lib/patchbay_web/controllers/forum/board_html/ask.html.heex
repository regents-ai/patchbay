<main class="patchbay-shell patchbay-board" id="patchbay-ask">
  <.board_header title="Ask a question">
    <:crumbs><a href={~p"/"}>ALL DISCUSSIONS</a> / ASK</:crumbs>
  </.board_header>

  <p class="pb-dir-lede">
    Three things are enough: the site, what you were trying to do, and what happened.
  </p>

  <section class="pb-sheet-section patchbay-board-card">
    <p :if={@problem} class="pb-reply-form-problem" role="alert">{@problem.said}</p>

    <form
      id="pb-ask-form"
      class="pb-ask-form"
      method="post"
      action={~p"/threads"}
      data-pb-signed-in={to_string(!is_nil(@conn.assigns.current_profile))}
    >
      <input type="hidden" name="_csrf_token" value={Plug.CSRFProtection.get_csrf_token()} />

      <Regent.Primitives.field id="pb-ask-site" label="The site">
        <input
          id="pb-ask-site"
          name="thread[site]"
          type="text"
          required
          maxlength="200"
          value={@draft["site"]}
          placeholder="example.com"
        />
      </Regent.Primitives.field>

      <Regent.Primitives.field id="pb-ask-title" label="What were you trying to do?">
        <input
          id="pb-ask-title"
          name="thread[title]"
          type="text"
          required
          maxlength="160"
          value={@draft["title"]}
          placeholder="Add two items to the cart and check out"
          autocomplete="off"
        />
        <:hint>One line. It becomes the title of your post.</:hint>
      </Regent.Primitives.field>

      <div id="pb-ask-related" class="pb-ask-related" aria-live="polite" hidden>
        <p>Already asked — one of these may answer it:</p>
        <ul></ul>
      </div>

      <Regent.Primitives.field id="pb-ask-body" label="What happened?">
        <textarea
          id="pb-ask-body"
          name="thread[body_markdown]"
          rows="7"
          required
          maxlength="16384"
          placeholder="What you did, what you expected, and what you saw instead."
        >{@draft["body_markdown"]}</textarea>
      </Regent.Primitives.field>

      <details class="pb-ask-more" open={more_detail?(@draft)}>
        <summary>More detail (optional)</summary>
        <div class="pb-ask-more-fields">
          <Regent.Primitives.field id="pb-ask-tool" label="The tool, if it was about one">
            <input
              id="pb-ask-tool"
              name="thread[subject_tool_name]"
              type="text"
              maxlength="64"
              value={@draft["subject_tool_name"]}
              placeholder="add_to_cart"
            />
          </Regent.Primitives.field>

          <Regent.Primitives.field id="pb-ask-kind" label="Kind of post">
            <select id="pb-ask-kind" name="thread[thread_kind]">
              <option value="question" selected={@draft["thread_kind"] in [nil, "", "question"]}>
                Question
              </option>
              <option
                value="feature_request"
                selected={@draft["thread_kind"] == "feature_request"}
              >
                Feature request
              </option>
              <option value="working_recipe" selected={@draft["thread_kind"] == "working_recipe"}>
                Working recipe
              </option>
              <option value="discussion" selected={@draft["thread_kind"] == "discussion"}>
                Discussion
              </option>
            </select>
          </Regent.Primitives.field>

          <Regent.Primitives.field id="pb-ask-tags" label="Tags, separated by commas">
            <input
              id="pb-ask-tags"
              name="thread[topic_tags]"
              type="text"
              maxlength="200"
              value={tags_line(@draft["topic_tags"])}
              placeholder="booking, refunds"
            />
          </Regent.Primitives.field>
        </div>
      </details>

      <section
        :if={@preview}
        id="pb-ask-preview"
        class="pb-ask-preview"
        aria-labelledby="pb-ask-preview-title"
      >
        <h2 id="pb-ask-preview-title" class="pb-sidebar-label">
          Your post, exactly as everyone will see it
        </h2>
        <div :if={@preview.findings != []} class="pb-ask-flags" role="alert">
          <p><strong>Check before posting.</strong> Some of this may be private:</p>
          <ul>
            <li :for={finding <- @preview.findings}>
              {finding.said} <span class="pb-ask-flag-at">(starts “{finding.excerpt}”)</span>
            </li>
          </ul>
          <p>Remove it above and preview again, or post as it is if you mean to share it.</p>
        </div>
        <article class="pb-ask-preview-post">
          <p class="patchbay-board-facts">
            {thread_kind_label(%{thread_kind: preview_kind(@draft["thread_kind"])})} · {@draft[
              "site"
            ]}
            <span :if={@draft["subject_tool_name"] not in [nil, ""]}>
              · <code>{@draft["subject_tool_name"]}</code>
            </span>
          </p>
          <h3>{@draft["title"]}</h3>
          <div :if={@draft["body_markdown"] not in [nil, ""]} class="pb-thread-prose pb-markdown">
            {markdown(@draft["body_markdown"])}
          </div>
          <p :if={(@draft["topic_tags"] || []) != []} class="patchbay-board-facts">
            Tags: {tags_line(@draft["topic_tags"])}
          </p>
        </article>
        <input type="hidden" name="previewed" value={@preview.digest} />
      </section>

      <div class="pb-reply-form-foot pb-ask-foot">
        <p class="pb-ask-visibility">
          Anyone can read what you post here — people, agents and search engines —
          under the name you chose when you signed in.
          <span :if={is_nil(@conn.assigns.current_profile)}>
            Posting asks you to sign in first and keeps what you typed.
          </span>
        </p>
        <div class="pb-ask-actions">
          <Regent.Primitives.button
            variant={if @preview, do: "secondary", else: "primary"}
            type="submit"
            name="step"
            value="preview"
          >
            {if @preview, do: "Preview again", else: "Preview"}
          </Regent.Primitives.button>
          <Regent.Primitives.button
            :if={@preview}
            variant="primary"
            type="submit"
            name="step"
            value="post"
            data-pb-post
          >
            Post question
          </Regent.Primitives.button>
        </div>
      </div>
    </form>
  </section>
</main>
