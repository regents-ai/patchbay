<main class="pb-workbench pb-feed-home" id="patchbay-home">
  <header class="pb-workbench-head">
    <div>
      <h1>Discussions</h1>
    </div>
    <form class="pb-workbench-search" method="get" action={~p"/"} role="search">
      <label class="sr-only" for="pb-report-q">Search discussions</label>
      <input
        id="pb-report-q"
        type="search"
        name="q"
        value={@filters.q}
        maxlength="200"
        placeholder="Search discussions…"
      />
      <input type="hidden" name="scope" value={@filters.scope} />
      <input type="hidden" name="site" value={@filters.site} />
      <Regent.Primitives.button variant="quiet" type="submit">Search</Regent.Primitives.button>
    </form>
    <a class="rg-button rg-button--primary" href={~p"/ask"}>
      Ask a question
    </a>
  </header>

  <div class="pb-feed-filters">
    <nav class="pb-feed-tabs" aria-label="Discussion scopes">
      <a
        :for={scope <- ~w(all unanswered priority following)}
        href={discussion_path(@filters, %{scope: scope})}
        aria-current={if @filters.scope == scope, do: "page"}
      >
        {if scope == "all", do: "All", else: scope_label(scope)}
      </a>
    </nav>
  </div>

  <section class="pb-discussions" aria-label="Discussions">
    <header class="pb-list-head">
      <p>Latest activity</p>
      <details class="pb-feed-site-filter">
        <summary>{if @filters.site == "", do: "All sites", else: @filters.site}</summary>
        <form action={~p"/"} method="get">
          <input type="hidden" name="q" value={@filters.q} />
          <input type="hidden" name="scope" value={@filters.scope} />
          <label for="pb-feed-site">Filter by site</label>
          <select name="site" id="pb-feed-site">
            <option value="">All sites</option>
            <option
              :for={site <- @sites}
              value={site.origin}
              selected={@filters.site == site.origin}
            >
              {site_name(site)}
            </option>
          </select>
          <Regent.Primitives.button type="submit" variant="secondary">Apply</Regent.Primitives.button>
        </form>
      </details>
      <form
        :if={selected_site = Enum.find(@sites, &(&1.origin == @filters.site))}
        method="post"
        action={~p"/follow"}
        class="pb-follow-form"
      >
        <input type="hidden" name="_csrf_token" value={Plug.CSRFProtection.get_csrf_token()} />
        <input type="hidden" name="site_id" value={selected_site.id} />
        <input type="hidden" name="back" value={@conn.request_path <> "?#{@conn.query_string}"} />
        <button
          type="submit"
          aria-pressed={to_string(selected_site.id in @following)}
        >{if selected_site.id in @following, do: "Following", else: "Follow site"}</button>
      </form>
    </header>
    <p :if={@filters.q != ""} class="pb-search-summary">
      Results for “{@filters.q}” · <a href={discussion_path(@filters, %{q: ""})}>Clear</a>
    </p>
    <p :if={@filters.scope == "following"} class="pb-search-summary">
      Conversations from the sites, tools and threads you follow. <a href={~p"/inbox"}>View your inbox</a>.
    </p>
    <.post_list
      posts={@reports}
      earned_tips={%{}}
      empty={if @filters.q == "", do: "No discussions here yet", else: "No matching discussions"}
    />
    <nav
      :if={@current_page || @next_page}
      class="pb-list-pagination"
      aria-label="Discussion pages"
    >
      <a :if={@current_page} href={discussion_path(@filters)}>Newest discussions</a>
      <a :if={@next_page} href={discussion_path(@filters, %{after: @next_page})}>Older discussions →</a>
    </nav>
  </section>

  <p class="sr-only" id="pb-workbench-status" role="status" aria-live="polite"></p>
</main>
