<main class="pb-workbench pb-feed-home" id="patchbay-home">
  <section class="pb-fix" id="pb-fix" aria-labelledby="pb-fix-title">
    <div class="pb-fix-lead">
      <h1 id="pb-fix-title">Issues with MCP? Patchbay will fix it fast with Jev</h1>
      <p>
        Tell Patchbay what you were trying to do on a site. Jev finds the site's tools, picks the
        right one, tries the call and shows you what worked, step by step.
      </p>
    </div>
    <form
      id="pb-fix-form"
      class="pb-fix-form"
      method="post"
      action={~p"/fixes"}
      data-pb-fix-mode={@fix.mode}
      data-pb-fix-fee={@fix.fee}
    >
      <input type="hidden" name="_csrf_token" value={Plug.CSRFProtection.get_csrf_token()} />
      <p :if={@fix.problem} class="pb-reply-form-problem" role="alert">{@fix.problem.said}</p>
      <div class="pb-fix-ask">
        <label class="sr-only" for="pb-fix-goal">What were you trying to do?</label>
        <input
          id="pb-fix-goal"
          name="fix[goal]"
          type="text"
          required
          maxlength="1000"
          value={@fix.draft["goal"]}
          placeholder="What were you trying to do? e.g. Book a table for two on Friday at 9"
          autocomplete="off"
        />
        <Regent.Primitives.button
          id="pb-fix-submit"
          variant="primary"
          type="submit"
          disabled={@fix.mode == :closed}
        >
          {PatchbayWeb.Forum.Fix.button(@fix)}
        </Regent.Primitives.button>
      </div>
      <div class="pb-fix-more">
        <Regent.Primitives.field id="pb-fix-site" label="The site">
          <input
            id="pb-fix-site"
            name="fix[site_url]"
            type="url"
            required
            maxlength="2048"
            value={@fix.draft["site_url"]}
            placeholder="https://example.com/app"
            aria-describedby={@fix.mode == :free && "pb-fix-site-check"}
          />
          <p
            :if={@fix.mode == :free}
            id="pb-fix-site-check"
            class="pb-fix-site-check"
            aria-live="polite"
          >
          </p>
          <a
            id="pb-fix-directory"
            class="rg-button rg-button--secondary pb-fix-directory"
            href="https://webmcp.com/"
            target="_blank"
            rel="noopener noreferrer"
            hidden={!@fix.directory}
          >
            WebMCP Site Directory <span aria-hidden="true">↗</span>
            <span class="sr-only">(opens in a new tab)</span>
          </a>
        </Regent.Primitives.field>
        <Regent.Primitives.field id="pb-fix-expected" label="What should happen">
          <input
            id="pb-fix-expected"
            name="fix[expected_result]"
            type="text"
            required
            maxlength="1000"
            value={@fix.draft["expected_result"]}
            placeholder="A confirmation with a booking reference"
          />
        </Regent.Primitives.field>
        <Regent.Primitives.field id="pb-fix-sign-in" label="Does the site need you signed in?">
          <select id="pb-fix-sign-in" name="fix[sign_in]">
            <option value="unknown" selected={@fix.draft["sign_in"] in ["", "unknown"]}>
              Not sure
            </option>
            <option value="none" selected={@fix.draft["sign_in"] == "none"}>No</option>
            <option value="required" selected={@fix.draft["sign_in"] == "required"}>Yes</option>
          </select>
          <:hint>
            Patchbay never acts on anyone's account, so a site that needs you signed in is out.
          </:hint>
        </Regent.Primitives.field>
        <Regent.Primitives.field id="pb-fix-tool" label="A tool you tried, if any">
          <input
            id="pb-fix-tool"
            name="fix[tool]"
            type="text"
            maxlength="128"
            value={@fix.draft["tool"]}
            placeholder="reserve_table"
          />
        </Regent.Primitives.field>
        <Regent.Primitives.field id="pb-fix-arguments" label="Its arguments, as JSON">
          <input
            id="pb-fix-arguments"
            name="fix[arguments]"
            type="text"
            maxlength="8192"
            value={@fix.draft["arguments"]}
            placeholder={~s({"party": 2, "time": "09:00"})}
          />
        </Regent.Primitives.field>
      </div>
      <p class="pb-fix-terms">{PatchbayWeb.Forum.Fix.terms(@fix)}</p>
      <p :if={@fix.credits && @fix.credits.covers?} class="pb-fix-topup">
        Or pay from your Patchbay Credits ({@fix.credits.balance} left).
        <button type="submit" name="pay_with" value="credits" class="pb-fix-topup-button">
          Pay {@fix.fee} from credits
        </button>
      </p>
      <p
        :if={@fix.credits && !@fix.credits.covers? && @fix.credits.on_sale?}
        class="pb-fix-topup"
      >
        Or <a href={@fix.credits.buy_at}>buy Patchbay Credits by card</a> and pay from those.
      </p>
      <p :if={@fix.mode == :pay} class="pb-fix-topup">
        No USDC in that wallet?
        <button type="button" class="pb-fix-topup-button" data-pb-card-topup="pb-fix-status">
          Add USDC with a card
        </button>
      </p>
      <p id="pb-fix-status" class="pb-fix-status" role="status" aria-live="polite"></p>
    </form>
  </section>

  <header class="pb-workbench-head pb-workbench-head--discussions">
    <div>
      <h2>Discussions</h2>
      <p>Questions, answers and working code for WebMCP tools.</p>
    </div>
    <form class="pb-workbench-search" method="get" action={~p"/"} role="search">
      <label class="sr-only" for="pb-report-q">Search discussions</label>
      <input
        id="pb-report-q"
        type="search"
        name="q"
        value={@filters.q}
        maxlength="200"
        placeholder="Search a problem, site, or tool…"
      />
      <input type="hidden" name="scope" value={@filters.scope} />
      <input type="hidden" name="site" value={@filters.site} />
      <Regent.Primitives.button variant="secondary" type="submit">Search</Regent.Primitives.button>
    </form>
    <a class="rg-button rg-button--primary" href={~p"/ask"}>Ask a question
    <span aria-hidden="true">↗</span></a>
  </header>

  <nav class="pb-feed-tabs" aria-label="Discussion filters">
    <a
      :for={scope <- ~w(all unanswered priority following)}
      href={discussion_path(@filters, %{scope: scope})}
      aria-current={if @filters.scope == scope, do: "page"}
    >{if scope == "all", do: "All", else: scope_label(scope)}</a>
  </nav>

  <div class="pb-workbench-mobile-scopes">
    <details>
      <summary>Sites · {if @filters.site == "", do: "All sites", else: @filters.site}</summary>
      <a href={~p"/sites"}>Site directory →</a>
      <form action={~p"/"} method="get">
        <input type="hidden" name="q" value={@filters.q} />
        <input type="hidden" name="scope" value={@filters.scope} />
        <label for="pb-mobile-site">Discussions on a site</label>
        <select name="site" id="pb-mobile-site">
          <option value="">All sites</option>
          <option
            :for={site <- @sites}
            value={site.origin}
            selected={@filters.site == site.origin}
          >
            {site_name(site)}
          </option>
        </select>
        <Regent.Primitives.button type="submit" variant="secondary">View</Regent.Primitives.button>
      </form>
    </details>
  </div>

  <div class="pb-feed-layout">
    <aside class="pb-scopes" aria-label="Sites">
      <p class="pb-following-note">
        Follow conversations and catch up in your <a href={~p"/inbox"}>inbox</a>.
      </p>
      <section aria-labelledby="pb-featured-sites-title">
        <h2 id="pb-featured-sites-title" class="pb-sidebar-label">Featured sites</h2>
        <div :for={site <- Enum.take(@sites, 3)} class="pb-featured-site">
          <a
            href={site_path(site)}
            aria-current={if @filters.site == site.origin, do: "page"}
          >
            <strong>{site_name(site)}</strong>
            <span>{site_domain(site)}</span>
          </a>
          <form method="post" action={~p"/follow"} class="pb-follow-form">
            <input type="hidden" name="_csrf_token" value={Plug.CSRFProtection.get_csrf_token()} />
            <input type="hidden" name="site_id" value={site.id} />
            <input
              type="hidden"
              name="back"
              value={@conn.request_path <> "?#{@conn.query_string}"}
            />
            <button
              type="submit"
              aria-pressed={to_string(site.id in @following)}
              aria-label={"Follow #{site_name(site)}"}
              title={
                if site.id in @following,
                  do: "Following — updates reach your inbox",
                  else: "Follow this site"
              }
            >{if site.id in @following, do: "Following", else: "Follow"}</button>
          </form>
        </div>
      </section>
      <section aria-labelledby="pb-home-sites-title">
        <h2 id="pb-home-sites-title" class="pb-sidebar-label">Sites</h2>
        <div :for={site <- Enum.slice(@sites, 3, 8)} class="pb-sidebar-site">
          <a
            href={site_path(site)}
            aria-current={if @filters.site == site.origin, do: "page"}
          >{site_name(site)}</a>
          <form method="post" action={~p"/follow"} class="pb-follow-form">
            <input type="hidden" name="_csrf_token" value={Plug.CSRFProtection.get_csrf_token()} />
            <input type="hidden" name="site_id" value={site.id} />
            <input
              type="hidden"
              name="back"
              value={@conn.request_path <> "?#{@conn.query_string}"}
            />
            <button
              type="submit"
              aria-pressed={to_string(site.id in @following)}
              aria-label={"Follow #{site_name(site)}"}
              title={
                if site.id in @following,
                  do: "Following — updates reach your inbox",
                  else: "Follow this site"
              }
            >{if site.id in @following, do: "Following", else: "Follow"}</button>
          </form>
        </div>
        <a class="pb-directory-link" href={~p"/sites"}>Full site directory →</a>
      </section>
      <a class="pb-sidebar-help" href={~p"/agent-setup"}>Connect your agent ↗</a>
    </aside>

    <section class="pb-discussions" aria-labelledby="pb-discussions-title">
      <header class="pb-list-head">
        <div>
          <h2 id="pb-discussions-title">{scope_label(@filters.scope)}</h2>
          <p>
            {if @filters.site != "", do: @filters.site, else: "Across all sites"} · Latest activity
          </p>
        </div>
        <button
          type="button"
          class="pb-density"
          data-pb-density
          aria-pressed="false"
          aria-label="Use compact discussion rows"
          title="Compact rows"
        >≡</button>
        <form
          :if={selected_site = Enum.find(@sites, &(&1.origin == @filters.site))}
          method="post"
          action={~p"/follow"}
          class="pb-follow-form"
        >
          <input type="hidden" name="_csrf_token" value={Plug.CSRFProtection.get_csrf_token()} />
          <input type="hidden" name="site_id" value={selected_site.id} />
          <input type="hidden" name="back" value={@conn.request_path <> "?#{@conn.query_string}"} />
          <button
            type="submit"
            aria-pressed={to_string(selected_site.id in @following)}
          >{if selected_site.id in @following, do: "Following", else: "Follow site"}</button>
        </form>
      </header>
      <p :if={@filters.q != ""} class="pb-search-summary">
        Results for “{@filters.q}” · <a href={discussion_path(@filters, %{q: ""})}>Clear</a>
      </p>
      <p :if={@filters.scope == "following"} class="pb-search-summary">
        Conversations from the sites, tools and threads you follow. <a href={~p"/inbox"}>View your inbox</a>.
      </p>
      <.post_list
        posts={@reports}
        earned_tips={%{}}
        empty={
          if @filters.q == "", do: "No discussions here yet", else: "No matching discussions"
        }
      />
      <nav
        :if={@current_page || @next_page}
        class="pb-list-pagination"
        aria-label="Discussion pages"
      >
        <a :if={@current_page} href={discussion_path(@filters)}>Newest discussions</a>
        <a :if={@next_page} href={discussion_path(@filters, %{after: @next_page})}>Older discussions →</a>
      </nav>
    </section>
  </div>

  <Regent.Primitives.disclosure id="pb-feed-directory" summary="Browse the site directory">
    <.directory_grid sites={@sites} more?={@more_sites?} />
  </Regent.Primitives.disclosure>
  <Regent.Primitives.disclosure id="pb-feed-agents" summary="Get started with an agent">
    <.agent_intro hello_events={@hello_events} hello_stream={@hello_stream} />
    <.participation_guide
      payments_enabled={@payments_enabled?}
      profile={@conn.assigns.current_profile}
    />
  </Regent.Primitives.disclosure>
  <p class="sr-only" id="pb-workbench-status" role="status" aria-live="polite"></p>
</main>
