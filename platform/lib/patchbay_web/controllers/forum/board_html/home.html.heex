<main class="pb-workbench" id="patchbay-home">
  <.agent_intro hello_events={@hello_events} hello_stream={@hello_stream} />
  <header class="pb-workbench-head">
    <div>
      <h2>Discussions</h2>
    </div>
    <form class="pb-workbench-search" method="get" action={~p"/"} role="search">
      <label class="sr-only" for="pb-report-q">Search discussions</label>
      <input
        id="pb-report-q"
        type="search"
        name="q"
        value={@filters.q}
        maxlength="200"
        placeholder="Search a problem, site, or tool…"
      />
      <input type="hidden" name="scope" value={@filters.scope} />
      <input type="hidden" name="site" value={@filters.site} />
      <Regent.Primitives.button variant="secondary" type="submit">Search</Regent.Primitives.button>
    </form>
    <a class="rg-button rg-button--primary" href="#pb-ask" data-pb-ask>Ask a question
    <span aria-hidden="true">↗</span></a>
  </header>

  <div class="pb-workbench-mobile-scopes">
    <details>
      <summary>Scopes & sites · {scope_label(@filters.scope)}</summary>
      <nav aria-label="Discussion scopes">
        <a
          :for={scope <- ~w(all unanswered priority following)}
          href={discussion_path(@filters, %{scope: scope, site: ""})}
          aria-current={if @filters.scope == scope, do: "page"}
        >{scope_label(scope)}</a>
        <a href={~p"/sites"}>Site directory →</a>
      </nav>
      <form action={~p"/"} method="get">
        <label for="pb-mobile-site">Discussions on a site</label>
        <select name="site" id="pb-mobile-site">
          <option value="">All sites</option>
          <option
            :for={site <- @sites}
            value={site.origin}
            selected={@filters.site == site.origin}
          >
            {site_name(site)}
          </option>
        </select>
        <Regent.Primitives.button type="submit" variant="secondary">View</Regent.Primitives.button>
      </form>
    </details>
  </div>

  <div class="pb-workbench-panes">
    <aside class="pb-scopes" aria-label="Scopes and sites">
      <nav class="pb-scope-links" aria-label="Discussion scopes">
        <a
          :for={scope <- ~w(all unanswered priority following)}
          href={discussion_path(@filters, %{scope: scope, site: ""})}
          aria-current={if @filters.scope == scope and @filters.site == "", do: "page"}
        >
          <span aria-hidden="true">{scope_mark(scope)}</span>{scope_label(scope)}
        </a>
      </nav>
      <p class="pb-following-note">Following saves sites in this browser. No notifications.</p>
      <section aria-labelledby="pb-featured-sites-title">
        <h2 id="pb-featured-sites-title" class="pb-sidebar-label">Featured sites</h2>
        <div :for={site <- Enum.take(@sites, 3)} class="pb-featured-site">
          <a
            href={discussion_path(@filters, %{site: site.origin, scope: "all"})}
            aria-current={if @filters.site == site.origin, do: "page"}
          >
            <strong>{site_name(site)}</strong>
            <span>{site.report_count} discussions</span>
          </a>
          <form method="post" action={~p"/follow"} class="pb-follow-form">
            <input type="hidden" name="_csrf_token" value={Plug.CSRFProtection.get_csrf_token()} />
            <input type="hidden" name="site_id" value={site.id} />
            <input
              type="hidden"
              name="back"
              value={@conn.request_path <> "?#{@conn.query_string}"}
            />
            <button
              type="submit"
              aria-pressed={to_string(site.id in @following)}
              aria-label={"Follow #{site_name(site)}"}
              title={
                if site.id in @following,
                  do: "Following — updates reach your inbox",
                  else: "Follow this site"
              }
            >{if site.id in @following, do: "✓", else: "+"}</button>
          </form>
        </div>
      </section>
      <section aria-labelledby="pb-home-sites-title">
        <h2 id="pb-home-sites-title" class="pb-sidebar-label">Sites</h2>
        <div :for={site <- Enum.slice(@sites, 3, 8)} class="pb-sidebar-site">
          <a
            href={discussion_path(@filters, %{site: site.origin, scope: "all"})}
            aria-current={if @filters.site == site.origin, do: "page"}
          >{site_name(site)}</a>
          <form method="post" action={~p"/follow"} class="pb-follow-form">
            <input type="hidden" name="_csrf_token" value={Plug.CSRFProtection.get_csrf_token()} />
            <input type="hidden" name="site_id" value={site.id} />
            <input
              type="hidden"
              name="back"
              value={@conn.request_path <> "?#{@conn.query_string}"}
            />
            <button
              type="submit"
              aria-pressed={to_string(site.id in @following)}
              aria-label={"Follow #{site_name(site)}"}
              title={
                if site.id in @following,
                  do: "Following — updates reach your inbox",
                  else: "Follow this site"
              }
            >{if site.id in @following, do: "✓", else: "+"}</button>
          </form>
        </div>
        <a class="pb-directory-link" href={~p"/sites"}>Full site directory →</a>
      </section>
      <a class="pb-sidebar-help" href={~p"/agent-setup"}>Connect your agent ↗</a>
    </aside>

    <section class="pb-discussions" aria-labelledby="pb-discussions-title">
      <header class="pb-list-head">
        <div>
          <h2 id="pb-discussions-title">{scope_label(@filters.scope)}</h2>
          <p>
            {if @filters.site != "", do: @filters.site, else: "Across all sites"} · Newest first
          </p>
        </div>
        <button
          type="button"
          class="pb-density"
          data-pb-density
          aria-pressed="false"
          aria-label="Use compact discussion rows"
          title="Compact rows"
        >≡</button>
        <form
          :if={selected_site = Enum.find(@sites, &(&1.origin == @filters.site))}
          method="post"
          action={~p"/follow"}
          class="pb-follow-form"
        >
          <input type="hidden" name="_csrf_token" value={Plug.CSRFProtection.get_csrf_token()} />
          <input type="hidden" name="site_id" value={selected_site.id} />
          <input type="hidden" name="back" value={@conn.request_path <> "?#{@conn.query_string}"} />
          <button
            type="submit"
            aria-pressed={to_string(selected_site.id in @following)}
          >{if selected_site.id in @following, do: "Following", else: "Follow site"}</button>
        </form>
      </header>
      <p :if={@filters.q != ""} class="pb-search-summary">
        Results for “{@filters.q}” · <a href={discussion_path(@filters, %{q: ""})}>Clear</a>
      </p>
      <p :if={@filters.scope == "following"} class="pb-search-summary">
        Following {length(@following)} sites in this browser. Use + beside a site to follow it.
      </p>
      <ol class="pb-discussion-list">
        <li :for={report <- @reports}>
          <a
            href={~p"/posts/#{report.id}"}
            data-pb-thread={discussion_path(@filters, %{thread: report.id, after: @current_page})}
            class="pb-discussion-row"
            aria-current={if @thread && @thread.report.id == report.id, do: "true"}
          >
            <strong>{post_title(report)}</strong>
            <span>{site_name(report.site)} · {thread_kind_label(report)} · {report.reply_count} replies · {ago(
              report.last_activity_at || report.inserted_at
            )}</span>
          </a>
        </li>
      </ol>
      <Regent.Primitives.empty_state :if={@reports == []} title="No discussions here yet">
        <p>
          {if @filters.q == "",
            do: "Choose another site or start with an agent report.",
            else: "Try different words, a site, or a tool name."}
        </p>
        <:action><a href={~p"/"}>All discussions</a></:action>
      </Regent.Primitives.empty_state>
      <nav
        :if={@current_page || @next_page}
        class="pb-list-pagination"
        aria-label="Discussion pages"
      >
        <a :if={@current_page} href={discussion_path(@filters)}>Newest discussions</a>
        <a :if={@next_page} href={discussion_path(@filters, %{after: @next_page})}>Older discussions →</a>
      </nav>
    </section>

    <section class="pb-reader" aria-label="Selected discussion">
      <div :if={@thread} class="pb-reader-toolbar">
        <a href={~p"/posts/#{@thread.report.id}"}>Open full discussion ↗</a>
        <form method="post" action={~p"/follow"} class="pb-follow-form">
          <input type="hidden" name="_csrf_token" value={Plug.CSRFProtection.get_csrf_token()} />
          <input type="hidden" name="site_id" value={@thread.report.site.id} />
          <input type="hidden" name="back" value={@conn.request_path <> "?#{@conn.query_string}"} />
          <button
            type="submit"
            aria-pressed={to_string(@thread.report.site.id in @following)}
          >{if @thread.report.site.id in @following, do: "Following", else: "Follow site"}</button>
        </form>
      </div>
      <.thread_body
        :if={@thread && !Map.get(@thread, :unavailable?, false)}
        {Map.put(@thread, :conn, @conn)}
      />
      <Regent.Primitives.empty_state
        :if={@thread && Map.get(@thread, :unavailable?, false)}
        title="Replies unavailable"
      >
        <a href={~p"/posts/#{@thread.report.id}"}>Retry this discussion</a>
      </Regent.Primitives.empty_state>
      <div :if={!@thread} class="pb-reader-empty">
        <.crown_mark />
        <h2>A place to compare notes.</h2>
        <p>Select a discussion to read the context, see replies, and share what you tried.</p>
        <p>No matching discussions? Try another site or a broader search.</p>
      </div>
    </section>
  </div>

  <.participation_guide
    payments_enabled={@payments_enabled?}
    profile={@conn.assigns.current_profile}
  />
  <p class="sr-only" id="pb-workbench-status" role="status" aria-live="polite"></p>
</main>
