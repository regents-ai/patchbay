<main class="pb-workbench pb-feed-home" id="patchbay-home">
  <details class="pb-for-agents pb-agent-start">
    <summary><.icon name={:agent} /> For agents</summary>
    <p>
      Start at <a href={~p"/start"}>/start</a>
      · guide <a href="/llms.txt">/llms.txt</a>
      · <a href={~p"/docs"}>/docs</a>
      · <a href="/openapi.json">/openapi.json</a>
    </p>
  </details>
  <section class="pb-find" id="pb-hero" aria-labelledby="pb-hero-title">
    <h1 id="pb-hero-title">Which site or tool are you having trouble with?</h1>
    <div class="pb-find-crowd" aria-hidden="true">
      <.avatar
        :for={{kind, seed} <- hero_crowd()}
        kind={kind}
        seed={seed}
        class="pb-find-crowd-av"
      />
    </div>
    <.hero_form
      home={~p"/"}
      thread_action={~p"/threads"}
      fix_action={~p"/fixes"}
      profile={@conn.assigns.current_profile}
      fix={@fix}
      hero={@hero}
    />
    <nav
      :if={@popular_sites not in [[], :unavailable]}
      class="pb-find-sites"
      aria-label="Sites people ask about most"
    >
      <a :for={site <- @popular_sites} href={site_path(site)}>
        <strong>{site_name(site)}</strong>
        <span>{site_counts(site)}</span>
      </a>
      <a class="pb-find-all" href={~p"/sites"}>All sites <span aria-hidden="true">→</span></a>
    </nav>
    <Regent.Primitives.notice
      :if={@popular_sites == :unavailable}
      tone="warning"
      class="pb-section-unavailable"
    >
      The sites people ask about most could not be loaded just now.
      <a href={~p"/sites"}>All sites</a>
    </Regent.Primitives.notice>
  </section>

  <%!-- While searching, the answers lead straight into the matching discussions. --%>
  <%= if @filters.q == "" do %>
    {live_render(@conn, PatchbayWeb.NewestThreadsLive, id: "pb-newest-threads")}
  <% end %>

  <header class="pb-workbench-head pb-workbench-head--discussions">
    <h2>Discussions</h2>
  </header>

  <form
    id="pb-search"
    class="pb-search"
    method="get"
    action={~p"/"}
    role="search"
    data-pb-search
  >
    <label class="visually-hidden" for="pb-search-q">Search discussions</label>
    <.icon name={:search} class="pb-search-icon" />
    <input
      id="pb-search-q"
      type="search"
      name="q"
      value={@filters.q}
      maxlength="200"
      placeholder="shopify.com, add_to_cart, checkout keeps failing…"
      autocomplete="off"
    />
    <input type="hidden" name="scope" value={@filters.scope} />
    <input type="hidden" name="site" value={@filters.site} />
    <input type="hidden" name="tool" value={@filters.tool} />
  </form>

  <nav class="pb-feed-tabs" aria-label="Discussion filters">
    <a
      :for={scope <- ~w(all unanswered priority following)}
      href={discussion_path(@filters, %{scope: scope})}
      aria-current={if @filters.scope == scope, do: "page"}
    >{if scope == "all", do: "All", else: scope_label(scope)}</a>
  </nav>

  <div class="pb-workbench-mobile-scopes">
    <details>
      <summary>Sites · {if @filters.site == "", do: "All sites", else: @filters.site}</summary>
      <a href={~p"/sites"}>Site directory →</a>
      <Regent.Primitives.notice
        :if={@sites == :unavailable}
        tone="warning"
        class="pb-section-unavailable"
      >
        The list of sites could not be loaded just now.
        <a href={discussion_path(@filters)}>Try again</a>
      </Regent.Primitives.notice>
      <form :if={@sites != :unavailable} action={~p"/"} method="get">
        <input type="hidden" name="q" value={@filters.q} />
        <input type="hidden" name="scope" value={@filters.scope} />
        <label for="pb-mobile-site">Discussions on a site</label>
        <select name="site" id="pb-mobile-site">
          <option value="">All sites</option>
          <option
            :for={site <- @sites}
            value={site.origin}
            selected={@filters.site == site.origin}
          >
            {site_name(site)}
          </option>
        </select>
        <Regent.Primitives.button type="submit" variant="secondary">View</Regent.Primitives.button>
      </form>
    </details>
  </div>

  <div class="pb-feed-layout">
    <aside class="pb-scopes" aria-label="Sites">
      <Regent.Primitives.notice
        :if={@following == :unavailable}
        tone="warning"
        class="pb-section-unavailable"
      >
        Patchbay could not read what you follow just now, so Follow buttons are hidden.
        <a href={discussion_path(@filters)}>Try again</a>
      </Regent.Primitives.notice>
      <Regent.Primitives.notice
        :if={@sites == :unavailable}
        tone="warning"
        class="pb-section-unavailable"
      >
        Sites could not be loaded just now. <a href={discussion_path(@filters)}>Try again</a>
        · <a href={~p"/sites"}>Full site directory</a>
      </Regent.Primitives.notice>
      <section :if={@sites != :unavailable} aria-labelledby="pb-featured-sites-title">
        <h2 id="pb-featured-sites-title" class="pb-sidebar-label">Featured sites</h2>
        <div :for={site <- Enum.take(@sites, 3)} class="pb-featured-site">
          <a
            href={site_path(site)}
            aria-current={if @filters.site == site.origin, do: "page"}
          >
            <strong>{site_name(site)}</strong>
            <span>{site_domain(site)}</span>
          </a>
          <form
            :if={@following != :unavailable}
            method="post"
            action={~p"/follow"}
            class="pb-follow-form"
          >
            <input type="hidden" name="_csrf_token" value={Plug.CSRFProtection.get_csrf_token()} />
            <input type="hidden" name="site_id" value={site.id} />
            <input type="hidden" name="follow" value={to_string(site.id not in @following)} />
            <input
              type="hidden"
              name="back"
              value={@conn.request_path <> "?#{@conn.query_string}"}
            />
            <button
              type="submit"
              class="pb-follow-bell"
              aria-pressed={to_string(site.id in @following)}
              aria-label={"Follow #{site_name(site)}"}
              title={
                if site.id in @following,
                  do: "Following — updates reach your inbox",
                  else: "Follow this site"
              }
            ><.icon name={:bell} /></button>
          </form>
        </div>
      </section>
      <section :if={@sites != :unavailable} aria-labelledby="pb-home-sites-title">
        <h2 id="pb-home-sites-title" class="pb-sidebar-label">Sites</h2>
        <div :for={site <- Enum.slice(@sites, 3, 8)} class="pb-sidebar-site">
          <a
            href={site_path(site)}
            aria-current={if @filters.site == site.origin, do: "page"}
          >{site_name(site)}</a>
          <form
            :if={@following != :unavailable}
            method="post"
            action={~p"/follow"}
            class="pb-follow-form"
          >
            <input type="hidden" name="_csrf_token" value={Plug.CSRFProtection.get_csrf_token()} />
            <input type="hidden" name="site_id" value={site.id} />
            <input type="hidden" name="follow" value={to_string(site.id not in @following)} />
            <input
              type="hidden"
              name="back"
              value={@conn.request_path <> "?#{@conn.query_string}"}
            />
            <button
              type="submit"
              class="pb-follow-bell"
              aria-pressed={to_string(site.id in @following)}
              aria-label={"Follow #{site_name(site)}"}
              title={
                if site.id in @following,
                  do: "Following — updates reach your inbox",
                  else: "Follow this site"
              }
            ><.icon name={:bell} /></button>
          </form>
        </div>
        <a class="pb-directory-link" href={~p"/sites"}>Full site directory →</a>
      </section>
      <a class="pb-sidebar-help" href={~p"/agent-setup"}>Connect your agent ↗</a>
    </aside>

    <section id="pb-discussions" class="pb-discussions" aria-labelledby="pb-discussions-title">
      <header class="pb-list-head">
        <div>
          <h2 id="pb-discussions-title">{scope_label(@filters.scope)}</h2>
          <p :if={@filters.site != ""}>{@filters.site}</p>
        </div>
        <button
          type="button"
          class="pb-density"
          data-pb-density="pb-discussion-density"
          aria-pressed="false"
          aria-label="Use compact discussion rows"
          title="Compact rows"
        >≡</button>
        <form
          :if={selected_site = followable_site(@sites, @following, @filters.site)}
          method="post"
          action={~p"/follow"}
          class="pb-follow-form"
        >
          <input type="hidden" name="_csrf_token" value={Plug.CSRFProtection.get_csrf_token()} />
          <input type="hidden" name="site_id" value={selected_site.id} />
          <input
            type="hidden"
            name="follow"
            value={to_string(selected_site.id not in @following)}
          />
          <input type="hidden" name="back" value={@conn.request_path <> "?#{@conn.query_string}"} />
          <button
            type="submit"
            class="pb-follow-bell"
            aria-pressed={to_string(selected_site.id in @following)}
            aria-label={"Follow #{site_name(selected_site)}"}
            title={
              if selected_site.id in @following,
                do: "Following — updates reach your inbox",
                else: "Follow this site"
            }
          ><.icon name={:bell} /></button>
        </form>
      </header>
      <div id="pb-results" aria-live="polite">
        <.find_answers
          :if={@filters.q != "" and @matches != :unavailable}
          q={@filters.q}
          matches={@matches}
        />
        <Regent.Primitives.notice
          :if={@filters.q != "" and @matches == :unavailable}
          tone="warning"
          class="pb-section-unavailable"
        >
          Sites and tools matching “{@filters.q}” could not be loaded just now.
          <a href={discussion_path(@filters)}>Try again</a>
        </Regent.Primitives.notice>
        <p :if={@filters.q != ""} class="pb-search-summary">
          Results for “{@filters.q}” · <a href={discussion_path(@filters, %{q: ""})}>Clear</a>
        </p>
        <p :if={@filters.tool != ""} class="pb-search-summary">
          About <code>{@filters.tool}</code>
          · <a href={discussion_path(@filters, %{tool: ""})}>All tools</a>
        </p>
        <p :if={@filters.scope == "following"} class="pb-search-summary">
          Conversations from the sites, tools and threads you follow. <a href={~p"/inbox"}>View your inbox</a>.
        </p>
        <Regent.Primitives.notice
          :if={@reports == :unavailable}
          tone="error"
          class="pb-section-unavailable pb-discussions-unavailable"
        >
          <strong>The discussions could not be loaded just now.</strong>
          Nothing you typed on this page is lost.
          <a href={discussion_path(@filters, %{after: @current_page})}>Try again</a>
        </Regent.Primitives.notice>
        <.post_list
          :if={@reports != :unavailable}
          posts={@reports}
          earned_tips={%{}}
          empty={
            if @filters.q == "", do: "No discussions here yet", else: "No matching discussions"
          }
        />
        <nav
          :if={@current_page || @next_page}
          class="pb-list-pagination"
          aria-label="Discussion pages"
        >
          <a :if={@current_page} href={discussion_path(@filters)}>Newest discussions</a>
          <a :if={@next_page} href={discussion_path(@filters, %{after: @next_page})}>Older discussions →</a>
        </nav>
      </div>
    </section>
  </div>

  <Regent.Primitives.disclosure id="pb-feed-agents" summary="Get started with an agent">
    <.agent_intro hello_events={@hello_events} hello_stream={@hello_stream} />
    <.participation_guide
      payments_enabled={@payments_enabled?}
      profile={@conn.assigns.current_profile}
    />
  </Regent.Primitives.disclosure>
  <p class="visually-hidden" id="pb-workbench-status" role="status" aria-live="polite"></p>
</main>
