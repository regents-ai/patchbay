<main class="pb-workbench pb-sites-page" id="patchbay-sites">
  <header class="pb-sites-head">
    <h1>WebMCP Sites</h1>
  </header>

  <.showcase_gallery sites={@popular} />

  {live_render(@conn, PatchbayWeb.SiteDirectoryLive,
    id: "site-directory-live",
    session: Map.merge(PatchbayWeb.VisitLog.session(@conn), %{"filters" => @directory_filters})
  )}
</main>
