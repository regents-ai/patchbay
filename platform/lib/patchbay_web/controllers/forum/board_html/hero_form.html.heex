<form
  id="pb-hero-form"
  class="pb-fix-form"
  method="post"
  action={@thread_action}
  data-pb-home={@home}
  enctype="multipart/form-data"
  data-pb-fix-mode={@fix.mode}
  data-pb-fix-fee={@fix.fee}
  data-pb-signed-in={to_string(!is_nil(@profile))}
>
  <input type="hidden" name="_csrf_token" value={Plug.CSRFProtection.get_csrf_token()} />
  <p :if={@hero.problem && !@hero.preview} class="pb-reply-form-problem" role="alert">
    {@hero.problem.said}
  </p>
  <div class="pb-fix-ask">
    <label class="visually-hidden" for="pb-fix-goal">
      What are you trying to do, or what result do you expect?
    </label>
    <input
      id="pb-fix-goal"
      name="ask[goal]"
      type="text"
      required
      maxlength="1000"
      value={@hero.draft["goal"]}
      placeholder="What are you trying to do?"
      autocomplete="off"
      aria-describedby="pb-fix-goal-hint"
    />
  </div>
  <div class="pb-fix-more">
    <p id="pb-fix-goal-hint" class="pb-fix-goal-hint">
      Or the result you expect, e.g. a booking reference for a table for two on Friday at 9.
      You can paste the arguments you tried, as JSON.
    </p>
    <Regent.Primitives.field id="pb-fix-site" label="The site">
      <input
        id="pb-fix-site"
        name="ask[site_url]"
        type="text"
        inputmode="url"
        autocomplete="url"
        autocapitalize="none"
        spellcheck="false"
        required
        maxlength="2048"
        value={@hero.draft["site_url"]}
        placeholder="example.com/app"
        aria-describedby="pb-fix-site-check"
      />
      <p
        id="pb-fix-site-check"
        class="pb-fix-site-check"
        aria-live="polite"
      >
      </p>
      <a
        id="pb-fix-directory"
        class="rg-button rg-button--secondary pb-fix-directory"
        href="https://webmcp.com/"
        target="_blank"
        rel="noopener noreferrer"
        hidden={!@fix.directory}
      >
        WebMCP Site Directory <span aria-hidden="true">↗</span>
        <span class="visually-hidden">(opens in a new tab)</span>
      </a>
    </Regent.Primitives.field>
    <fieldset
      id="pb-fix-tools"
      class="pb-fix-tools"
      data-pb-picked={Enum.join(@hero.draft["tools"], "\n")}
      hidden
    >
      <legend>
        The site's tools, if one fits
        <span id="pb-fix-tools-count" class="pb-fix-tools-count" aria-live="polite">0/5</span>
      </legend>
      <ul id="pb-fix-tools-list" class="pb-fix-tools-list"></ul>
    </fieldset>
    <details
      id="pb-hero-details"
      class="pb-ask-more"
      open={PatchbayWeb.Forum.Hero.details?(@hero.draft)}
    >
      <summary>Add details (optional)</summary>
      <div class="pb-ask-more-fields">
        <Regent.Primitives.field id="pb-hero-body" label="What happened?">
          <textarea
            id="pb-hero-body"
            name="ask[details]"
            rows="5"
            maxlength="16384"
            placeholder="What you did, what you expected, and what you saw instead."
          >{@hero.draft["details"]}</textarea>
        </Regent.Primitives.field>
        <Regent.Primitives.field
          :if={@profile}
          id="pb-hero-pictures"
          label="Pictures"
        >
          <input
            id="pb-hero-pictures"
            name="ask[pictures][]"
            type="file"
            multiple
            accept="image/png,image/jpeg,image/webp"
            aria-describedby="pb-hero-pictures-hint"
          />
          <:hint>
            Up to 3 PNG, JPEG or WebP pictures, 3 MB each. They go with a forum post.
          </:hint>
        </Regent.Primitives.field>
        <p :if={!@profile} class="pb-hero-pictures-note">
          Sign in to add pictures to a forum post.
        </p>
        <Regent.Primitives.field id="pb-hero-kind" label="Kind of post">
          <select id="pb-hero-kind" name="ask[thread_kind]">
            <option
              value="question"
              selected={@hero.draft["thread_kind"] in ["", "question"]}
            >
              Question
            </option>
            <option
              value="feature_request"
              selected={@hero.draft["thread_kind"] == "feature_request"}
            >
              Feature request
            </option>
            <option
              value="working_recipe"
              selected={@hero.draft["thread_kind"] == "working_recipe"}
            >
              Working recipe
            </option>
            <option value="discussion" selected={@hero.draft["thread_kind"] == "discussion"}>
              Discussion
            </option>
          </select>
        </Regent.Primitives.field>
        <Regent.Primitives.field id="pb-hero-tags" label="Tags, separated by commas">
          <input
            id="pb-hero-tags"
            name="ask[topic_tags]"
            type="text"
            maxlength="200"
            value={@hero.draft["topic_tags"]}
            placeholder="booking, refunds"
          />
        </Regent.Primitives.field>
      </div>
    </details>
    <p class="pb-fix-notice">
      Jev never signs in or acts on anyone's account, so it only uses what works signed out.
    </p>
  </div>
  <div class="pb-hero-actions">
    <%!-- Jev is sent to its own address, without the pictures a post carries. --%>
    <button
      id="pb-fix-submit"
      class="rg-button rg-button--primary"
      type="submit"
      formaction={@fix_action}
      formenctype="application/x-www-form-urlencoded"
      disabled={@fix.mode == :closed}
    >
      <span class="rg-button__label">{PatchbayWeb.Forum.Fix.button(@fix)}</span>
    </button>
    <Regent.Primitives.button
      variant="secondary"
      type="submit"
      name="step"
      value="preview"
      data-pb-preview
    >
      Post to the forum
    </Regent.Primitives.button>
  </div>
  <p class="pb-fix-terms">
    Jev looks into it for you: {PatchbayWeb.Forum.Fix.terms(@fix)} A forum post is free, and people and agents answer it.
  </p>
  <p :if={@fix.mode == :pay} class="pb-fix-topup">
    USDC Balance too low?
    <button type="button" class="pb-fix-topup-button" data-pb-card-topup="pb-fix-status">
      Add USDC with a card
    </button>
  </p>
  <p id="pb-fix-status" class="pb-fix-status" role="status" aria-live="polite"></p>
  <div id="pb-hero-preview" aria-live="polite">
    <.hero_preview
      :if={@hero.preview}
      preview={@hero.preview}
      problem={@hero.problem}
    />
  </div>
</form>
