<form
  id="pb-hero-form"
  class="pb-fix-form"
  method="post"
  action={@thread_action}
  data-pb-home={@home}
  enctype="multipart/form-data"
  data-pb-signed-in={to_string(!is_nil(@profile))}
  {@rest}
>
  <input type="hidden" name="_csrf_token" value={Plug.CSRFProtection.get_csrf_token()} />
  <p :if={!@profile} id="pb-hero-sign-in" class="pb-hero-sign-in">
    <span>Sign in to post.</span>
    <Regent.Primitives.button
      :if={@window}
      variant="secondary"
      type="button"
      data-account-target="sign-in"
    >
      Sign in
    </Regent.Primitives.button>
  </p>
  <p
    :if={hero_unplaced(@hero.problem) && !@hero.preview}
    class="pb-reply-form-problem"
    role="alert"
  >
    {@hero.problem.said}
  </p>
  <%!-- Each field carries the words for leaving it empty and for running too
  long, which the page says under it (hero_form.ts). --%>
  <Regent.Primitives.field
    :let={field}
    id="pb-fix-goal"
    label="Issue"
    class="pb-fix-ask"
    errors={hero_errors(@hero.problem, :goal)}
  >
    <input
      id="pb-fix-goal"
      name="ask[goal]"
      type="text"
      required
      maxlength="1000"
      value={@hero.draft["goal"]}
      placeholder="Describe your WebMCP issue"
      autocomplete="off"
      aria-invalid={field.aria_invalid}
      aria-describedby={field.described_by}
      data-pb-empty="Describe the issue."
      data-pb-most={PatchbayWeb.Forum.Hero.max_title()}
      data-pb-long={PatchbayWeb.Forum.Hero.title_fix()}
    />
  </Regent.Primitives.field>
  <div class="pb-fix-more">
    <Regent.Primitives.field
      :let={field}
      id="pb-fix-site"
      label="The site"
      errors={hero_errors(@hero.problem, :site)}
    >
      <input
        id="pb-fix-site"
        name="ask[site_url]"
        type="text"
        inputmode="url"
        autocomplete="url"
        autocapitalize="none"
        spellcheck="false"
        required
        maxlength="2048"
        value={@hero.draft["site_url"]}
        placeholder="example.com/app"
        aria-invalid={field.aria_invalid}
        aria-describedby={String.trim("pb-fix-site-check #{field.described_by}")}
        data-pb-empty="Name the site."
      />
      <p
        id="pb-fix-site-check"
        class="pb-fix-site-check"
        aria-live="polite"
      >
      </p>
      <a
        id="pb-fix-directory"
        class="rg-button rg-button--secondary pb-fix-directory"
        href={~p"/sites"}
        hidden={!@directory}
      >
        WebMCP Site Directory
      </a>
    </Regent.Primitives.field>
    <fieldset
      id="pb-fix-tools"
      class="pb-fix-tools"
      data-pb-picked={Enum.join(@hero.draft["tools"], "\n")}
      hidden
    >
      <legend>
        Tools
        <span id="pb-fix-tools-count" class="pb-fix-tools-count" aria-live="polite">0/5</span>
      </legend>
      <ul id="pb-fix-tools-list" class="pb-fix-tools-list"></ul>
    </fieldset>
    <details
      id="pb-hero-details"
      class="pb-ask-more pb-hero-details"
      open={PatchbayWeb.Forum.Hero.details?(@hero.draft, @hero.problem)}
    >
      <summary>
        <span>More</span>
        <Regent.Icons.icon name="chevron-down" class="pb-ask-more-chevron" />
      </summary>
      <div class="pb-ask-more-fields">
        <Regent.Primitives.field
          :let={field}
          id="pb-hero-body"
          label="Steps"
          errors={hero_errors(@hero.problem, :details)}
        >
          <textarea
            id="pb-hero-body"
            name="ask[details]"
            rows="5"
            maxlength="16384"
            aria-invalid={field.aria_invalid}
            aria-describedby={field.described_by}
            placeholder="The steps you took, the result you expected, and the result you saw."
          >{@hero.draft["details"]}</textarea>
        </Regent.Primitives.field>
        <Regent.Primitives.field
          :let={field}
          :if={@profile}
          id="pb-hero-pictures"
          label="Pictures"
          errors={hero_errors(@hero.problem, :pictures)}
        >
          <input
            id="pb-hero-pictures"
            name="ask[pictures][]"
            type="file"
            multiple
            accept="image/png,image/jpeg,image/webp"
            aria-invalid={field.aria_invalid}
            aria-describedby={field.described_by}
          />
        </Regent.Primitives.field>
        <p :if={!@profile} class="pb-hero-pictures-note">
          Sign in to add pictures to a forum post.
        </p>
        <%!-- One type at a time; pressing the picked one again leaves the
        choice to Patchbay, as nothing picked does. --%>
        <fieldset id="pb-hero-kind" class="pb-hero-kind">
          <legend>Post type</legend>
          <label :for={{value, label} <- thread_types()}>
            <input
              type="radio"
              name="ask[thread_kind]"
              value={value}
              checked={@hero.draft["thread_kind"] == value}
            />
            <span>{label}</span>
          </label>
        </fieldset>
        <Regent.Primitives.field
          :let={field}
          id="pb-hero-tags"
          label="Tags"
          errors={hero_errors(@hero.problem, :tags)}
        >
          <input
            id={field.id}
            name="ask[topic_tags]"
            type="text"
            maxlength="200"
            aria-invalid={field.aria_invalid}
            aria-describedby={field.described_by}
            value={@hero.draft["topic_tags"]}
            placeholder="booking, refunds"
          />
        </Regent.Primitives.field>
      </div>
    </details>
  </div>
  <div class="pb-hero-actions">
    <Regent.Primitives.button
      variant="secondary"
      type="submit"
      name="step"
      value="preview"
      data-pb-preview
    >
      <span class="pb-action-label" data-press-label>Post to agent forum</span>
    </Regent.Primitives.button>
  </div>
  <p id="pb-fix-status" class="pb-fix-status" role="status" aria-live="polite"></p>
  <div id="pb-hero-preview" aria-live="polite">
    <.hero_preview
      :if={@hero.preview}
      preview={@hero.preview}
      problem={hero_unplaced(@hero.problem)}
    />
  </div>
</form>
