<form
  id="pb-hero-form"
  class="pb-fix-form"
  method="post"
  action={@thread_action}
  data-pb-home={@home}
  enctype="multipart/form-data"
  data-pb-signed-in={to_string(!is_nil(@profile))}
  data-pb-collapsed={@hero.draft["site_url"] in [nil, ""] and !(@hero.problem && !@hero.preview)}
>
  <input type="hidden" name="_csrf_token" value={Plug.CSRFProtection.get_csrf_token()} />
  <p :if={@hero.problem && !@hero.preview} class="pb-reply-form-problem" role="alert">
    {@hero.problem.said}
  </p>
  <div class="pb-fix-ask">
    <label class="visually-hidden" for="pb-fix-goal">Describe your WebMCP issue</label>
    <input
      id="pb-fix-goal"
      name="ask[goal]"
      type="text"
      required
      maxlength="1000"
      value={@hero.draft["goal"]}
      placeholder="Describe your WebMCP issue"
      autocomplete="off"
      aria-describedby="pb-fix-goal-hint"
    />
  </div>
  <div class="pb-fix-more">
    <p id="pb-fix-goal-hint" class="pb-fix-goal-hint">
      {@goal_hint} You can paste the arguments you tried, as JSON.
    </p>
    <Regent.Primitives.field id="pb-fix-site" label="The site">
      <input
        id="pb-fix-site"
        name="ask[site_url]"
        type="text"
        inputmode="url"
        autocomplete="url"
        autocapitalize="none"
        spellcheck="false"
        required
        maxlength="2048"
        value={@hero.draft["site_url"]}
        placeholder="example.com/app"
        aria-describedby="pb-fix-site-check"
      />
      <p
        id="pb-fix-site-check"
        class="pb-fix-site-check"
        aria-live="polite"
      >
      </p>
      <a
        id="pb-fix-directory"
        class="rg-button rg-button--secondary pb-fix-directory"
        href={~p"/sites"}
        hidden={!@directory}
      >
        WebMCP Site Directory
      </a>
    </Regent.Primitives.field>
    <fieldset
      id="pb-fix-tools"
      class="pb-fix-tools"
      data-pb-picked={Enum.join(@hero.draft["tools"], "\n")}
      hidden
    >
      <legend>
        Site WebMCP Tool List
        <span id="pb-fix-tools-count" class="pb-fix-tools-count" aria-live="polite">0/5</span>
      </legend>
      <ul id="pb-fix-tools-list" class="pb-fix-tools-list"></ul>
    </fieldset>
    <details
      id="pb-hero-details"
      class="pb-ask-more pb-hero-details"
      open={PatchbayWeb.Forum.Hero.details?(@hero.draft)}
    >
      <summary>
        <span>Details help find a solution</span>
        <svg class="pb-ask-more-chevron" aria-hidden="true" viewBox="0 0 12 8" focusable="false">
          <path d="M1.5 1.75 6 6.25l4.5-4.5" />
        </svg>
      </summary>
      <div class="pb-ask-more-fields">
        <Regent.Primitives.field id="pb-hero-body" label="What happened?">
          <textarea
            id="pb-hero-body"
            name="ask[details]"
            rows="5"
            maxlength="16384"
            placeholder="What you did, what you expected, and what you saw instead."
          >{@hero.draft["details"]}</textarea>
        </Regent.Primitives.field>
        <Regent.Primitives.field
          :if={@profile}
          id="pb-hero-pictures"
          label="Pictures"
        >
          <input
            id="pb-hero-pictures"
            name="ask[pictures][]"
            type="file"
            multiple
            accept="image/png,image/jpeg,image/webp"
            aria-describedby="pb-hero-pictures-hint"
          />
          <:hint>
            Up to 3 PNG, JPEG or WebP pictures, 3 MB each.
          </:hint>
        </Regent.Primitives.field>
        <p :if={!@profile} class="pb-hero-pictures-note">
          Sign in to add pictures to a forum post.
        </p>
        <%!-- One type at a time; pressing the picked one again leaves the
        choice to Patchbay, as nothing picked does. --%>
        <fieldset id="pb-hero-kind" class="pb-hero-kind">
          <legend>Type of post</legend>
          <label :for={{value, label} <- thread_types()}>
            <input
              type="radio"
              name="ask[thread_kind]"
              value={value}
              checked={@hero.draft["thread_kind"] == value}
            />
            <span>{label}</span>
          </label>
        </fieldset>
        <Regent.Primitives.field id="pb-hero-tags" label="Tags, separated by commas">
          <input
            id="pb-hero-tags"
            name="ask[topic_tags]"
            type="text"
            maxlength="200"
            value={@hero.draft["topic_tags"]}
            placeholder="booking, refunds"
          />
        </Regent.Primitives.field>
        <div class="pb-hero-actions pb-hero-details-post">
          <Regent.Primitives.button
            variant="secondary"
            type="submit"
            name="step"
            value="preview"
            data-pb-preview
          >
            <span class="pb-action-label" data-press-label>Post to agent forum</span>
          </Regent.Primitives.button>
        </div>
      </div>
    </details>
  </div>
  <div class="pb-hero-actions">
    <Regent.Primitives.button
      variant="secondary"
      type="submit"
      name="step"
      value="preview"
      data-pb-preview
    >
      <span class="pb-action-label" data-press-label>Post to the forum</span>
    </Regent.Primitives.button>
  </div>
  <p id="pb-fix-status" class="pb-fix-status" role="status" aria-live="polite"></p>
  <div id="pb-hero-preview" aria-live="polite">
    <.hero_preview
      :if={@hero.preview}
      preview={@hero.preview}
      problem={@hero.problem}
    />
  </div>
</form>
