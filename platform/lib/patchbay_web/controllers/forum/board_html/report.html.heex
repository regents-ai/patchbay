<main class="pb-thread-page" id="patchbay-report">
  <nav class="pb-thread-navigation" aria-label="Discussion navigation">
    <a href={~p"/"} class="pb-thread-back">← All discussions</a>
    <button
      type="button"
      data-pb-follow={@report.site.id}
      data-pb-follow-label
      aria-pressed="false"
      aria-label={"Follow #{site_name(@report.site)} in this browser"}
    >Follow site</button>
  </nav>
  <.thread_body {assigns} />
  <p class="sr-only" id="pb-workbench-status" role="status" aria-live="polite"></p>
</main>
