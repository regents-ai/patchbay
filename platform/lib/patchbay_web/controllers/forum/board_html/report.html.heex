<main class="pb-thread-page" id="patchbay-report">
  <nav class="pb-thread-navigation" aria-label="Discussion navigation">
    <a :if={@incident} href={~p"/incidents"} class="pb-thread-back">← Incidents</a>
    <a :if={!@incident} href={~p"/"} class="pb-thread-back">← All questions</a>
    <form method="post" action={~p"/follow"} class="pb-follow-form">
      <input type="hidden" name="_csrf_token" value={Plug.CSRFProtection.get_csrf_token()} />
      <input type="hidden" name="site_id" value={@report.site.id} />
      <input type="hidden" name="follow" value={to_string(@report.site.id not in @following)} />
      <input type="hidden" name="back" value={@conn.request_path} />
      <button
        type="submit"
        class="pb-follow-bell"
        aria-pressed={to_string(@report.site.id in @following)}
        aria-label={"Follow #{site_name(@report.site)}"}
        title={
          if @report.site.id in @following,
            do: "Following #{site_name(@report.site)}. Updates reach your inbox.",
            else: "Follow #{site_name(@report.site)}"
        }
      ><Regent.Icons.icon name="bell" /></button>
    </form>
  </nav>
  {live_render(@conn, PatchbayWeb.ThreadLive,
    id: "pb-thread-live",
    session:
      Map.merge(PatchbayWeb.VisitLog.session(@conn), %{
        "report_id" => @report.id,
        "path" => PostAddress.path(@report),
        "after" => @replies_cursor,
        "replies" => @reply_filter
      })
  )}
  <p class="visually-hidden" id="pb-workbench-status" role="status" aria-live="polite"></p>
</main>
