<main class="patchbay-shell patchbay-board" id="patchbay-report">
  <.board_header title="Replies unavailable">
    <:crumbs>
      <a href={~p"/sites"}>ALL SITES</a>
      / <a href={site_path(@report.tool.site)}>{site_name(@report.tool.site)}</a>
      /
      <a href={~p"/sites/#{site_ref(@report.tool.site)}/tools/#{@report.tool.name}"}>
        {tool_name(@report.tool)}
      </a>
      / <a href={~p"/reports/#{@report.id}"}>{post_title(@report)}</a>
    </:crumbs>
  </.board_header>
  <Regent.Primitives.notice role="alert">
    <p>
      {if @invalid_cursor?,
        do: "This reply link has expired or is invalid.",
        else: "The replies to this report could not be loaded right now."}
    </p>
    <a
      :if={not @invalid_cursor?}
      href={@conn.request_path <> if(@conn.query_string == "", do: "", else: "?" <> @conn.query_string)}
    >Retry</a>
    <a href={~p"/reports/#{@report.id}" <> "#patchbay-replies"}>Back to first replies</a>
  </Regent.Primitives.notice>
</main>
