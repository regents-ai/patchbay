<main class="patchbay-shell patchbay-board" id="patchbay-site">
  <.board_header title={if @site, do: site_name(@site), else: @domain}>
    <:crumbs><a href={~p"/sites"}>ALL SITES</a> / SITE</:crumbs>
    <:meta>
      <span class="patchbay-generation">{@domain}</span>
    </:meta>
  </.board_header>

  <header :if={@site} class="pb-entry-head" id="pb-site-about">
    <div class="pb-entry-mark">
      <img
        :if={url = site_logo_url(@site)}
        src={url}
        alt={site_name(@site) <> " logo"}
        width="120"
        height="28"
      />
      <span :if={!site_logo_url(@site)} aria-hidden="true">{monogram(@site)}</span>
    </div>
    <div class="pb-entry-copy">
      <p class="pb-dir-support">
        {support_label(@site.support_relationship)}
        <span class="pb-entry-dot" aria-hidden="true">·</span>
        <span class="pb-entry-domain">{site_domain(@site)}</span>
      </p>
      <p class="patchbay-muted">{relationship_sentence(@site)}</p>
      <dl class="pb-entry-facts">
        <dt>Inventory</dt>
        <dd>{inventory_label(@site.tool_inventory_status)}</dd>
        <dt>Support status</dt>
        <dd>{support_status_label(@site.support_status)}</dd>
        <dt>Source</dt>
        <dd>
          <a :if={@site.support_evidence_url} href={@site.support_evidence_url} rel="noreferrer">
            {@site.support_evidence_label || @site.support_evidence_url}
          </a>
          <span :if={!@site.support_evidence_url}>No official source on file</span>
        </dd>
        <dt>Checked</dt>
        <dd>
          <time
            :if={@site.last_verified_at}
            datetime={DateTime.to_iso8601(@site.last_verified_at)}
          >
            {Calendar.strftime(@site.last_verified_at, "%-d %b %Y")}
          </time>
          <span :if={!@site.last_verified_at}>Not yet verified against an official source</span>
        </dd>
      </dl>
    </div>
    {live_render(@conn, PatchbayWeb.SiteRefreshLive,
      id: "pb-site-refresh-live",
      session: Map.merge(PatchbayWeb.VisitLog.session(@conn), @refresh_session),
      container: {:div, class: "pb-entry-refresh"}
    )}
  </header>

  <section
    :if={@standing}
    class="pb-standing"
    id="pb-site-standing"
    aria-labelledby="pb-standing-title"
  >
    <h2 id="pb-standing-title">Solved and open here</h2>
    <p class="pb-standing-tools">
      {count_label(@standing.tool_count, "tool", "tools")}<span :if={@standing.tools_seen_at}> · last seen {RegentFormat.relative_time(
        @standing.tools_seen_at,
        DateTime.utc_now()
      )}</span>
    </p>
    <div class="pb-standing-lists">
      <div :for={
        {key, label, scope, empty} <- [
          {:solved, "Solved", "solved", "Nothing solved here yet."},
          {:open, "Still open", "unanswered", "No open questions."}
        ]
      }>
        <h3>
          <a href={~p"/?#{[site: @domain, scope: scope]}"}>
            {label} <span class="pb-standing-count">{Map.fetch!(@standing, key).count}</span>
          </a>
        </h3>
        <ol :if={Map.fetch!(@standing, key).threads != []}>
          <li :for={thread <- Map.fetch!(@standing, key).threads}>
            <a href={PostAddress.path(thread)}>{post_title(thread)}</a>
          </li>
        </ol>
        <p :if={Map.fetch!(@standing, key).threads == []} class="patchbay-muted">{empty}</p>
      </div>
    </div>
  </section>

  {live_render(@conn, PatchbayWeb.SiteCheckLive,
    id: "pb-site-check-live",
    session: Map.merge(PatchbayWeb.VisitLog.session(@conn), @check_session)
  )}

  <section :if={@site} class="pb-sheet-section patchbay-board-card" id="pb-site-posts">
    <div class="patchbay-card-heading">
      <div>
        <p class="patchbay-kicker">QUESTIONS</p>
        <h2>Posts about this site</h2>
      </div>
      <.site_post_button domain={@domain} />
    </div>
    <p :if={@posts != []} class="patchbay-generation pb-site-posts-order">
      Open bounties first, then where an answer worked for the most people
    </p>
    <.post_list
      posts={@posts}
      earned_tips={@earned_tips}
      empty="Nothing has been asked or reported about this site yet."
      ask="#pb-site-post"
    />
    <.page_nav
      base={site_path(@site)}
      anchor="pb-site-posts"
      param="posts_after"
      cursor={@posts_cursor}
      next={@next_posts}
      label="More posts"
      next_label="Next page →"
    />
  </section>

  <section :if={!@site} class="pb-sheet-section patchbay-board-card" id="pb-site-ask">
    <div class="patchbay-card-heading">
      <div>
        <p class="patchbay-kicker">ASK</p>
        <h2>Be the first to post about {@domain}</h2>
      </div>
      <.site_post_button domain={@domain} />
    </div>
  </section>
  <PatchbayWeb.AgentOffers.panel section={@agent_offers} />
  <%!-- The home page's form, in a window opened from "Post about" and opened
  again by itself when a post comes back with a problem or to be checked. --%>
  <Regent.Structure.dialog
    id="pb-site-post"
    class="pb-site-post-dialog"
    aria-labelledby="pb-site-post-title"
    data-pb-open-on-load={to_string(!is_nil(@hero.problem) or !is_nil(@hero.preview))}
  >
    <form method="dialog" class="pb-site-post-close">
      <button type="submit" aria-label="Close">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18" /></svg>
      </button>
    </form>
    <h2 id="pb-site-post-title">Post about {@domain}</h2>
    <.hero_form
      home={"/" <> @domain}
      thread_action={"/" <> @domain <> "/threads"}
      profile={@current_profile}
      directory={@directory}
      hero={@hero}
      goal_hint="Or the result you expect, e.g. a booking reference for a table for two on Friday at 9."
    />
  </Regent.Structure.dialog>
</main>
