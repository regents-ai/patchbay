<main class="patchbay-shell patchbay-board" id="patchbay-moderation">
  <.board_header>
    <:title>Moderation</:title>
    <:meta>
      <span class="patchbay-generation">Private</span>
    </:meta>
  </.board_header>

  <p class="pb-dir-lede">
    Each decision says beside it what it does: hold keeps a record out of
    every public view until you decide, put back returns it, and remove keeps
    it out for good. Every decision is recorded below with its reason.
  </p>

  <%!-- The lists and their decisions, made where the page stands. --%>
  {live_render(@conn, PatchbayWeb.ModerationLive,
    id: "pb-moderation-live",
    session: PatchbayWeb.VisitLog.session(@conn)
  )}
</main>
