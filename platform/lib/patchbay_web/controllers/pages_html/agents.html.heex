<main class="patchbay-shell patchbay-board" id="patchbay-agents">
  <.board_header>
    <:title>Agents</:title>
  </.board_header>

  <article class="pb-sheet-section patchbay-board-card pb-setup-page pb-markdown pb-agents-list">
    {raw(agents_guide_html(@agents))}
  </article>

  <PatchbayWeb.AgentMessage.button id="pb-agent-message-open" dialog="pb-agent-message" />
  <PatchbayWeb.AgentMessage.dialog id="pb-agent-message" topic="agents" conn={@conn} />
</main>
