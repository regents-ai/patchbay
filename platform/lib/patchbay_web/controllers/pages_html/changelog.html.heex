<main class="patchbay-shell patchbay-board pb-changelog" id="patchbay-changelog">
  <header class="pb-changelog__header">
    <h1>Changelog</h1>
    <p>Changes to Patchbay, newest first.</p>
    <a
      href="https://github.com/regents-ai/patchbay/blob/main/CHANGELOG.md"
      target="_blank"
      rel="noopener noreferrer"
      aria-label="View on GitHub (opens in a new tab)"
    >
      View on GitHub <span aria-hidden="true">↗</span>
    </a>
  </header>

  <div :if={@intro_html != "" and @page == 1} class="pb-changelog__intro">{raw(@intro_html)}</div>
  <article :for={{entry, n} <- Enum.with_index(@entries, @before)} class="pb-changelog__release">
    <PatchbayWeb.AddressText.address_text id={"pb-changelog-#{n}-address"} pieces={entry} />
  </article>
  <nav :if={@pages > 1} class="pb-changelog__pages" aria-label="Changelog pages">
    <a
      :if={@page > 1}
      href={if @page == 2, do: ~p"/changelog", else: ~p"/changelog?#{[page: @page - 1]}"}
      rel="prev"
    >← Newer</a>
    <span>Page {@page} of {@pages}</span>
    <a :if={@page < @pages} href={~p"/changelog?#{[page: @page + 1]}"} rel="next">Older →</a>
  </nav>
</main>
