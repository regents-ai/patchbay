<main class="patchbay-shell patchbay-board" id="connected-apps">
  <.board_header>
    <:title>Connected apps</:title>
    <:crumbs><a href={~p"/"}>ALL QUESTIONS</a> / CONNECTED APPS</:crumbs>
  </.board_header>

  <p class="pb-dir-lede">
    Sign in to see the apps you have connected to Patchbay, and to disconnect any of them.
  </p>

  <Regent.Primitives.button variant="primary" type="button" data-account-target="sign-in">
    Sign in
  </Regent.Primitives.button>
</main>
