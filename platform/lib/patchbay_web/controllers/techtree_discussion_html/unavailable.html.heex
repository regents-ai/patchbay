<main class="patchbay-shell patchbay-board" id="patchbay-techtree-unavailable">
  <.board_header title="Techtree Result discussion">
    <:crumbs>PATCHBAY / TECHTREE</:crumbs>
  </.board_header>

  <article class="pb-sheet-section patchbay-board-card pb-setup-page">
    <section>
      <p>
        We couldn't reach Techtree to confirm this Result just now, so its discussion isn't open yet. Try again in a minute.
      </p>
      <p><a href={@entry_url}>See the Result on Techtree</a></p>
    </section>
  </article>
</main>
