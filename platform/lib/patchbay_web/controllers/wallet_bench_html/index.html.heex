<main class="patchbay-shell" id="patchbay-wallet-bench">
  <section class="pb-wb-sheet" aria-labelledby="pb-wb-title">
    <.bench_header test={@test.grid} filters={@matrix.filters} />

    <div class="pb-wb-board-head">
      <div>
        <h2>{grid_title(@test.grid)}</h2>
        <p>{@test.tested} of {@test.total} squares have results · {@test.never_run} never run</p>
      </div>
      <details class="rg-pill-select pb-wb-filter" id="pb-wb-filter">
        <summary>{filter_label(@matrix.filters)}</summary>
        <form method="get" action={~p"/wallet-bench"} aria-label="Filter recorded versions">
          <input type="hidden" name="test" value={@test.grid} />
          <div
            :for={
              {key, title} <- [
                {"harness", "Agent version"},
                {"wallet", "Wallet version"},
                {"model", "Model"},
                {"protocol", "Protocol"}
              ]
            }
            class="rg-field"
          >
            <label for={"pb-wb-filter-" <> key}>{title}</label>
            <select id={"pb-wb-filter-" <> key} name={key}>
              <option value="">Any recorded version</option>
              <option
                :for={option <- @matrix.options[key]}
                value={option.id}
                selected={@matrix.filters[key] == option.id}
              >
                {option.label}
              </option>
            </select>
          </div>
          <p>Each square shows its current set, or the newest one matching these choices.</p>
          <div class="pb-wb-filter-actions">
            <button class="rg-button rg-button--secondary" type="submit">
              <span class="rg-button__label">Show</span>
            </button>
            <a href={~p"/wallet-bench?test=#{@test.grid}"}>Reset</a>
          </div>
        </form>
      </details>
    </div>

    <div
      :if={@test.total > 0}
      class="pb-wb-scroll"
      role="region"
      tabindex="0"
      aria-label={grid_title(@test.grid) <> " board, scrolls sideways"}
    >
      <table class="pb-wb-board">
        <thead>
          <tr>
            <th scope="col" class="pb-wb-corner">
              <span class="visually-hidden">Agent, then each wallet</span>
            </th>
            <th :for={wallet <- @matrix.wallets} scope="col">
              <.entry
                entry={wallet}
                notes={@matrix.notes}
                never_run={never_run(column(@test, @test.harnesses, wallet))}
              />
            </th>
          </tr>
        </thead>
        <tbody>
          <tr :for={harness <- @test.harnesses}>
            <th scope="row">
              <.entry
                entry={harness}
                notes={@matrix.notes}
                never_run={never_run(row(@test, @matrix.wallets, harness))}
              />
            </th>
            <td :for={wallet <- @matrix.wallets}>
              <.square
                notes={@matrix.notes}
                square={@test.squares[{harness.id, wallet.id}]}
                harness={harness}
                wallet={wallet}
                grid={@test.grid}
                filters={@matrix.filters}
                said={
                  List.wrap(never_run(column(@test, @test.harnesses, wallet))) ++
                    List.wrap(never_run(row(@test, @matrix.wallets, harness)))
                }
              />
            </td>
          </tr>
        </tbody>
      </table>
    </div>
    <p :if={@test.total == 0}>No results to show yet.</p>

    <p class="pb-wb-legend">
      <span>Each dot is a check, held in</span>
      <span :for={{tone, label} <- dot_key()}>
        <span class={["pb-wb-dot", tone]} aria-hidden="true"></span>{label}
      </span>
    </p>
    <p class="pb-wb-more">
      <a href={~p"/wallet-bench/how-it-works"}>How the bench works</a>
    </p>
  </section>

  <dialog id="pb-wb-dialog" class="pb-wb-dialog" aria-labelledby="pb-wb-dialog-title">
    <div class="pb-wb-dialog-bar">
      <h2 id="pb-wb-dialog-title"></h2>
      <form method="dialog">
        <button class="rg-button rg-button--secondary" type="submit">
          <span class="rg-button__label">Close</span>
        </button>
      </form>
    </div>
    <div class="pb-wb-dialog-body" data-wb-body></div>
    <p class="pb-wb-dialog-error" data-wb-error hidden>
      These runs did not load. <a data-wb-page href="">Open them on their own page</a>
    </p>
  </dialog>
</main>
