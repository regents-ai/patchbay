<main class="patchbay-shell" id="patchbay-wallet-bench">
  <section class="pb-wb-sheet" aria-labelledby="pb-wb-title">
    <header class="pb-wb-head">
      <p class="pb-wb-kicker"><a href={~p"/"}>Patchbay</a> · Wallet bench</p>
      <h1 id="pb-wb-title">Agent × Wallet Bench</h1>
      <p class="pb-wb-lede">
        Coding agents set up crypto wallets and use them on their own. Each square is one agent with one wallet; its nine dots are the test's nine checks.
        <a href="#how-it-works">How the bench works</a>
      </p>
    </header>

    <nav class="pb-wb-tabs" aria-label="Tests">
      <a
        :for={grid <- @matrix.grids}
        href={~p"/wallet-bench?test=#{grid.grid}"}
        aria-current={grid.grid == @test.grid && "page"}
      >
        {grid_title(grid.grid)}
      </a>
    </nav>

    <div class="pb-wb-board-head">
      <h2>{grid_title(@test.grid)}</h2>
      <p>{@test.tested} of {@test.total} squares have results · {@test.never_run} never run</p>
    </div>

    <div
      :if={@test.total > 0}
      class="pb-wb-scroll"
      role="region"
      tabindex="0"
      aria-label={grid_title(@test.grid) <> " board, scrolls sideways"}
    >
      <table class="pb-wb-board">
        <thead>
          <tr>
            <th scope="col" class="pb-wb-corner">
              <span class="visually-hidden">Agent, then each wallet</span>
            </th>
            <th :for={wallet <- @matrix.wallets} scope="col">
              <.entry
                entry={wallet}
                notes={@matrix.notes}
                never_run={never_run(column(@test, @test.harnesses, wallet))}
              />
            </th>
          </tr>
        </thead>
        <tbody>
          <tr :for={harness <- @test.harnesses}>
            <th scope="row">
              <.entry
                entry={harness}
                notes={@matrix.notes}
                never_run={never_run(row(@test, @matrix.wallets, harness))}
              />
            </th>
            <td :for={wallet <- @matrix.wallets}>
              <.square
                notes={@matrix.notes}
                square={@test.squares[{harness.id, wallet.id}]}
                harness={harness}
                wallet={wallet}
                grid={@test.grid}
                said={
                  List.wrap(never_run(column(@test, @test.harnesses, wallet))) ++
                    List.wrap(never_run(row(@test, @matrix.wallets, harness)))
                }
              />
            </td>
          </tr>
        </tbody>
      </table>
    </div>
    <p :if={@test.total == 0}>No results to show yet.</p>

    <div class="pb-wb-cards">
      <article class="pb-wb-card" aria-labelledby="pb-wb-checks-title">
        <h2 id="pb-wb-checks-title">The nine checks</h2>
        <.check_key criteria={@test.criteria} />
      </article>
      <article class="pb-wb-card" aria-labelledby="pb-wb-key-title">
        <h2 id="pb-wb-key-title">Reading a dot</h2>
        <p>
          A dot shows how often the check held across the pair’s completed runs, including reruns.
        </p>
        <ul class="pb-wb-legend">
          <li :for={{tone, label} <- dot_key()}>
            <span class={["pb-wb-dot", tone]} aria-hidden="true"></span>{label}
          </li>
          <li>
            <span class="pb-wb-dot is-empty" aria-hidden="true"></span>Never run: the reason is shown beside it
          </li>
        </ul>
        <Regent.Primitives.disclosure id="pb-wb-meanings" summary="What each result means">
          <dl class="pb-wb-meanings">
            <div :for={outcome <- outcomes()} :if={Map.has_key?(@matrix.notes, outcome)}>
              <dt><.chip notes={@matrix.notes} outcome={outcome} /></dt>
              <dd>{@matrix.notes[outcome]}</dd>
            </div>
          </dl>
        </Regent.Primitives.disclosure>
      </article>
    </div>
  </section>

  <.method />

  <section class="pb-sheet-section">
    <p class="patchbay-muted">
      Results come from
      <.out href="https://techtree.sh">Techtree</.out>
      as each run finishes. The first survey is on <a href={~p"/blog/agent-wallet-bench-v7"}>the blog</a>.
    </p>
  </section>

  <dialog id="pb-wb-dialog" class="pb-wb-dialog" aria-labelledby="pb-wb-dialog-title">
    <div class="pb-wb-dialog-bar">
      <h2 id="pb-wb-dialog-title"></h2>
      <form method="dialog">
        <button class="rg-button rg-button--secondary" type="submit">
          <span class="rg-button__label">Close</span>
        </button>
      </form>
    </div>
    <div class="pb-wb-dialog-body" data-wb-body></div>
    <p class="pb-wb-dialog-error" data-wb-error hidden>
      These runs did not load. <a data-wb-page href="">Open them on their own page</a>
    </p>
  </dialog>
</main>
