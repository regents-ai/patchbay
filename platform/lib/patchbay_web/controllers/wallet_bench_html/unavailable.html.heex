<main class="patchbay-shell" id="patchbay-wallet-bench">
  <section class="pb-wb-sheet" aria-labelledby="pb-wb-unavailable">
    <h1 id="pb-wb-unavailable">{@heading}</h1>
    <Regent.Primitives.notice tone="info">{@words}</Regent.Primitives.notice>
    <a class="rg-button rg-button--secondary" href="">
      <span class="rg-button__label">Try again</span>
    </a>
  </section>
</main>
