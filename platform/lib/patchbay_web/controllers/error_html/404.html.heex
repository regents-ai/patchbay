<!DOCTYPE html>
<html lang="en" data-brand="patchbay" data-theme={theme(@conn)}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Page not found · Patchbay</title>
    <meta name="robots" content="noindex" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="stylesheet" href={~p"/assets/js/app.css"} />
  </head>
  <body>
    <Regent.Structure.frame>
      <Regent.Structure.row rail={false}>
        <main class="pb-error">
          <Regent.Structure.panel class="pb-error-inner">
            <h1>Not found</h1>
            <a class="pb-cta rg-button rg-button--primary" href="/"><span class="rg-button__label">Home</span></a>
          </Regent.Structure.panel>
        </main>
      </Regent.Structure.row>
    </Regent.Structure.frame>
  </body>
</html>
