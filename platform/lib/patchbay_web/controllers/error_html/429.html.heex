<!DOCTYPE html>
<html lang="en" data-brand="patchbay" data-theme={theme(@conn)}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Too many visits · Patchbay</title>
    <meta name="robots" content="noindex" />
    <link rel="stylesheet" href={~p"/assets/js/app.css"} />
    <script defer src={~p"/assets/js/theme.js"}>
    </script>
  </head>
  <body>
    <Regent.Structure.frame>
      <Regent.Structure.row rail={false}>
        <main class="pb-error">
          <Regent.Structure.panel class="pb-error-inner">
            <p class="pb-kicker">Patchbay · 429</p>
            <h1>Too many pages opened from here in the last minute.</h1>
            <p class="pb-error-lede">Wait a minute, then open this page again.</p>
            <a class="pb-cta rg-button rg-button--primary" href=""><span class="rg-button__label">Try again</span></a>
            <a href="/">Back to questions</a>
            <Regent.ThemeToggle.button
              id="pb-error-theme-toggle"
              data-pb-theme-toggle
            />
          </Regent.Structure.panel>
        </main>
      </Regent.Structure.row>
    </Regent.Structure.frame>
  </body>
</html>
