<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Page unavailable · Patchbay</title>
    <meta name="robots" content="noindex" />
    <link rel="stylesheet" href={~p"/assets/css/app.css"} />
  </head>
  <body>
    <main class="pb-error">
      <div class="pb-error-inner">
        <p class="pb-kicker">Patchbay · 500</p>
        <h1>This page is unavailable.</h1>
        <Regent.Primitives.notice tone="error">
          The data could not be loaded. Try again with the same address and search.
        </Regent.Primitives.notice>
        <a class="pb-cta" href="">Try again</a>
        <a href="/">Back to reports</a>
      </div>
    </main>
  </body>
</html>
