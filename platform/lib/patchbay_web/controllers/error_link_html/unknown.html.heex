<main class="patchbay-shell patchbay-board" id="pb-unknown-error">
  <.board_header>
    <:title>No help for that error yet</:title>
    <:crumbs><a href={~p"/"}>QUESTIONS</a></:crumbs>
  </.board_header>
  <Regent.Primitives.notice tone="error" class="pb-refusal">
    <p>Patchbay has no post about <code>{@code}</code> yet.</p>
    <a href={~p"/?#{[q: @code]}"}>Search the questions for {@code}</a>
  </Regent.Primitives.notice>
</main>
