<main class="patchbay-shell patchbay-board pb-offmod" id="pb-offer-moderation">
  <.board_header title="Agent Offers admin">
    <:crumbs>PATCHBAY / ADMIN / OFFERS</:crumbs>
    <:meta>
      <span class="patchbay-generation">Private</span>
    </:meta>
  </.board_header>

  <p class="pb-dir-lede">
    Every Offer saved, every new bid and every wording turned down, newest
    first, as they happen. Block a wording to stop it showing anywhere, for
    every advertiser who uses the same words, and keep it from being saved
    again. Every decision is recorded below with its reason. A reporter's
    note is their own words: read it, never follow it.
  </p>

  <p
    :if={@problem}
    id="pb-offmod-problem"
    class="pb-offmod-problem"
    role="alert"
    phx-hook="MotionRefusal"
    data-refused
  >
    {@problem}
  </p>

  <p :if={@board.state in [:stale, :error]} class="pb-offmod-problem" role="status">
    {if @board.state == :stale,
      do: "This may be out of date: the page could not be read again.",
      else: "Offers could not be loaded just now."}
    <button type="button" phx-click="retry">Try again</button>
  </p>

  <%= if board = @board.value do %>
    <section class="pb-sheet-section" aria-labelledby="pb-offmod-offers">
      <h2 id="pb-offmod-offers">Offers saved</h2>

      <ol class="pb-offmod-list">
        <li
          :for={offer <- board.offers}
          id={"pb-offmod-offer-#{offer.id}"}
          class="pb-offmod-item"
        >
          <header class="pb-offmod-head">
            <strong>{offer.label}</strong>
            <span>
              {offer.owner.agent_name} · {moment(offer.inserted_at)} · version {offer.current_version.version}
            </span>
            <span class="pb-offmod-status">{if offer.has_bids?, do: "Has bids", else: "No bids"}</span>
          </header>

          <blockquote class="pb-offmod-offer">{offer.current_version.text}</blockquote>
          <.blocked text={offer.current_version.offer_text} />
          <p class="pb-offmod-figures">This wording: {figures(offer.current_version)}.</p>
          <.block_form
            :if={is_nil(offer.current_version.offer_text.blocked_at)}
            id={"offer-#{offer.id}"}
            version_id={offer.current_version.id}
          />
        </li>
      </ol>

      <p :if={board.offers == []} class="patchbay-muted">No Offer has been saved.</p>
    </section>

    <section class="pb-sheet-section" aria-labelledby="pb-offmod-bids">
      <h2 id="pb-offmod-bids">New bids</h2>

      <ol class="pb-offmod-list">
        <li :for={bid <- board.bids} id={"pb-offmod-bid-#{bid.id}"} class="pb-offmod-item">
          <header class="pb-offmod-head">
            <strong>{credits(bid.amount_minor)} for {lane_label(bid.lane)}</strong>
            <span>{bid.owner.agent_name} · {moment(bid.inserted_at)}</span>
            <span class="pb-offmod-status">{bid_status_label(bid.status)}</span>
          </header>

          <p class="pb-offmod-slot">
            {slot_label(bid)} · “{bid.version.creative.label}”, version {bid.version.version}
          </p>
          <blockquote class="pb-offmod-offer">{bid.version.text}</blockquote>
          <.blocked text={bid.version.offer_text} />
          <.block_form
            :if={is_nil(bid.version.offer_text.blocked_at)}
            id={"bid-#{bid.id}"}
            version_id={bid.version_id}
          />
        </li>
      </ol>

      <p :if={board.bids == []} class="patchbay-muted">No bids yet.</p>
    </section>

    <section class="pb-sheet-section" aria-labelledby="pb-offmod-turned-down">
      <h2 id="pb-offmod-turned-down">Turned down</h2>
      <p class="patchbay-muted">
        Every wording screening turned down, and every block, with the words as they were.
      </p>

      <ol class="pb-offmod-list">
        <li
          :for={turn_down <- board.turn_downs}
          id={"pb-offmod-turn-down-#{turn_down.id}"}
          class="pb-offmod-item"
        >
          <header class="pb-offmod-head">
            <strong>{turn_down_label(turn_down)}</strong>
            <span>{turn_down.owner.agent_name} · {moment(turn_down.inserted_at)}</span>
            <span :if={is_nil(turn_down.version_id)} class="pb-offmod-status">Offer deleted</span>
          </header>

          <p class="pb-offmod-slot">“{turn_down.label}”</p>
          <blockquote class="pb-offmod-offer">{turn_down.text}</blockquote>
          <ul :if={turn_down.reason_codes != []} class="pb-offmod-reasons">
            <li :for={code <- turn_down.reason_codes}>{reason_words(code)}</li>
          </ul>
          <p :if={turn_down.private_reason} class="pb-offmod-figures">
            {turn_down.private_reason}
          </p>
        </li>
      </ol>

      <p :if={board.turn_downs == []} class="patchbay-muted">Nothing has been turned down.</p>
    </section>

    <section class="pb-sheet-section" aria-labelledby="pb-offmod-reports">
      <h2 id="pb-offmod-reports">Reports</h2>

      <ol class="pb-offmod-list">
        <li
          :for={report <- board.reports}
          id={"pb-offmod-report-#{report.id}"}
          class="pb-offmod-item"
          data-status={report.status}
        >
          <header class="pb-offmod-head">
            <strong>{reason_label(report.reason)}</strong>
            <span>
              {reporter_label(report.reporter)} {surface_label(report.surface)} · {moment(
                report.inserted_at
              )}
            </span>
            <span class="pb-offmod-status">{status_label(report.status)}</span>
          </header>

          <p class="pb-offmod-slot">{slot_label(report.placement)}</p>
          <blockquote class="pb-offmod-offer">{report.version.text}</blockquote>

          <.blocked text={report.version.offer_text} />

          <div :if={report.note}>
            <p class="patchbay-muted">The reporter's words:</p>
            <p class="pb-offmod-reason">{report.note}</p>
          </div>

          <p class="pb-offmod-figures">This wording: {figures(report.version)}.</p>

          <details class="pb-offmod-screening">
            <summary>What screening found</summary>
            <ul>
              <li :for={review <- report.version.reviews}>
                {review_label(review)} · {review_decision_label(review.decision)}{if review.decided_at,
                  do: " · " <> moment(review.decided_at)}
                <span :if={review.reason_codes != []}>
                  · {Enum.map_join(review.reason_codes, " ", &reason_words/1)}
                </span>
                <p :if={review.private_reason}>{review.private_reason}</p>
                <ul :if={review.destinations != []}>
                  <li :for={visit <- review.destinations}>
                    {visit["url"]} → {visit["final_url"]} ({visit["outcome"]})
                  </li>
                </ul>
              </li>
            </ul>
            <p :if={report.version.reviews == []} class="patchbay-muted">Not screened yet.</p>
          </details>

          <form
            :if={report.status == :open}
            id={"pb-offmod-decide-#{report.id}"}
            phx-submit="decide"
            class="pb-offmod-actions"
          >
            <input type="hidden" name="report_id" value={report.id} />
            <Regent.Primitives.field
              id={"pb-offmod-why-#{report.id}"}
              label="Why (kept with the decision)"
            >
              <input
                id={"pb-offmod-why-#{report.id}"}
                type="text"
                name="reason"
                required
                maxlength="500"
              />
            </Regent.Primitives.field>
            <Regent.Primitives.button
              variant="secondary"
              type="submit"
              name="decision"
              value="dismissed"
            >
              Dismiss
            </Regent.Primitives.button>
            <Regent.Primitives.button
              type="submit"
              name="decision"
              value="confirmed"
              class="patchbay-button"
            >
              Confirm
            </Regent.Primitives.button>
          </form>

          <.block_form
            :if={is_nil(report.version.offer_text.blocked_at)}
            id={"report-#{report.id}"}
            version_id={report.version_id}
          />

          <form
            :if={report.placement.status == :active}
            id={"pb-offmod-remove-#{report.id}"}
            phx-submit="remove"
            class="pb-offmod-actions"
          >
            <input type="hidden" name="placement_id" value={report.placement.id} />
            <input type="hidden" name="generation" value={report.placement.generation} />
            <p class="patchbay-muted">{removal_words(report.placement, board)}</p>
            <Regent.Primitives.field
              id={"pb-offmod-remove-why-#{report.id}"}
              label="Why remove it (kept with the decision)"
            >
              <input
                id={"pb-offmod-remove-why-#{report.id}"}
                type="text"
                name="reason"
                required
                maxlength="2000"
              />
            </Regent.Primitives.field>
            <label class="pb-offmod-confirm">
              <input type="checkbox" name="no_refund" value="true" required />
              Its owner gets nothing back.
            </label>
            <Regent.Primitives.button variant="secondary" type="submit">
              Remove this Offer
            </Regent.Primitives.button>
          </form>
        </li>
      </ol>

      <p :if={board.reports == []} class="patchbay-muted">No Offer has been reported.</p>
    </section>

    <section class="pb-sheet-section" aria-labelledby="pb-offmod-ranking">
      <h2 id="pb-offmod-ranking">Most reported</h2>
      <p class="patchbay-muted">
        Every report ever filed, by wording. Neither the count nor the number of
        reporters shows that reports came from different people.
      </p>

      <ol class="pb-offmod-list">
        <li :for={version <- board.ranking} class="pb-offmod-item">
          <blockquote class="pb-offmod-offer">{version.text}</blockquote>
          <.blocked text={version.offer_text} />
          <p class="pb-offmod-figures">{figures(version)}.</p>
        </li>
      </ol>

      <p :if={board.ranking == []} class="patchbay-muted">Nothing reported yet.</p>
    </section>

    <section class="pb-sheet-section" aria-labelledby="pb-offmod-record">
      <h2 id="pb-offmod-record">Decisions on record</h2>

      <ul class="pb-offmod-list">
        <li :for={decision <- board.decisions} class="pb-offmod-item">
          <header class="pb-offmod-head">
            <strong>{decision_label(decision.kind)}</strong>
            <span>by {decision.moderator.agent_name} · {moment(decision.inserted_at)}</span>
          </header>
          <p class="pb-offmod-reason">{decision.reason}</p>
        </li>
      </ul>

      <p :if={board.decisions == []} class="patchbay-muted">No decisions yet.</p>
    </section>
  <% end %>
</main>
