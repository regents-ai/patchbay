<main class="patchbay-shell patchbay-board pb-offers" id="pb-offers-expired">
  <.board_header title="Past Offers">
    <:crumbs>PATCHBAY / OFFERS / PAST</:crumbs>
  </.board_header>

  <p class="pb-dir-lede">
    Your Offers that have ended, newest first, with where their USDC went, and your bids that
    did not win.
  </p>

  <p class="pb-offers-cta">
    <.link navigate={~p"/offers/active"} class="rg-button rg-button--secondary">
      Your active Offers
    </.link>
    <.link navigate={~p"/offers/list"} class="rg-button rg-button--secondary">
      See every market
    </.link>
  </p>

  <p :if={!@signed_in?} class="patchbay-muted">
    Sign in at the top of the page to see your past Offers.
  </p>

  <%= if @signed_in? do %>
    <section class="pb-sheet-section" aria-labelledby="pb-offers-ended">
      <h2 id="pb-offers-ended">Offers that ended</h2>
      <ol id="pb-offers-ended-list" class="pb-offmod-list" phx-update="stream">
        <li :for={{dom_id, placement} <- @streams.ended} id={dom_id} class="pb-offmod-item">
          <header class="pb-offmod-head">
            <strong>{slot_label(placement.slot)}</strong>
            <span>{ended(placement.status)}</span>
          </header>
          <.offer_copy version={placement.version} />
          <p class="patchbay-muted">
            Started {moment(placement.starts_at)} · ended {moment(placement.ended_at)} · ran for {ran_for(
              placement
            )}
          </p>
          <p class="pb-offmod-figures">
            Paid {usdc(placement.amount_minor)} · used {usdc(placement.consumed_minor)} ·
            returned {usdc(placement.returned_minor)} · forfeited {usdc(placement.forfeited_minor)}
          </p>
          <p>
            Cost in the end:
            <strong>{usdc(placement.amount_minor - placement.returned_minor)}</strong>
          </p>
        </li>
        <li id="pb-offers-ended-empty" class="pb-offers-empty patchbay-muted">
          None of your Offers has ended yet.
        </li>
      </ol>
      <Regent.Primitives.button
        :if={@ended_more?}
        variant="secondary"
        phx-click="more"
        phx-value-list="ended"
      >
        Show more
      </Regent.Primitives.button>
    </section>

    <section class="pb-sheet-section" aria-labelledby="pb-offers-returned">
      <h2 id="pb-offers-returned">Bids that did not win</h2>
      <p class="patchbay-muted">Each of these came back in full.</p>
      <ol id="pb-offers-returned-list" class="pb-offmod-list" phx-update="stream">
        <li :for={{dom_id, bid} <- @streams.returned} id={dom_id} class="pb-offmod-item">
          <header class="pb-offmod-head">
            <strong>{slot_label(bid.slot)}</strong>
            <span>{usdc(bid.amount_minor)} returned</span>
          </header>
          <.offer_copy version={bid.version} />
          <p>{returned(bid.return_reason)}</p>
          <p class="patchbay-muted">
            Bid {moment(bid.accepted_at)} · returned {moment(bid.resolved_at)}
          </p>
        </li>
        <li id="pb-offers-returned-empty" class="pb-offers-empty patchbay-muted">
          No bid of yours has come back.
        </li>
      </ol>
      <Regent.Primitives.button
        :if={@returned_more?}
        variant="secondary"
        phx-click="more"
        phx-value-list="returned"
      >
        Show more
      </Regent.Primitives.button>
    </section>
  <% end %>
</main>
