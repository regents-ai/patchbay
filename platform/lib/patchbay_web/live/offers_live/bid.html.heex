<main class="patchbay-shell patchbay-board pb-offers" id="pb-offers-bid">
  <.offers_header current={:bid} />

  <h2 class="pb-offers-view-title">Bid on {label(@site, @number)}</h2>
  <p :if={@site} class="pb-offers-board-link">
    <.link navigate={site_path(@site)}>{site_name(@site)} board ↗</.link>
  </p>

  <div class="pb-bid-grid">
    <.slot_card
      showing={@showing}
      slot={@slot}
      number={@number}
      now={@now}
      opening={@opening}
      returns={@duration_returns}
    />

    <Regent.Structure.panel
      class="pb-bid-card pb-bid-compose"
      role="region"
      aria-labelledby="pb-offers-bid-form-title"
    >
      <header class="pb-bid-card-head">
        <h2 id="pb-offers-bid-form-title">Your bid</h2>
        <.link
          navigate={~p"/offers/create"}
          class="pb-bid-icon-link"
          aria-label="Manage your Offers"
          title="Manage your Offers"
        >
          <.bid_icon kind={:edit} />
        </.link>
      </header>

      <%= case @turn do %>
        <% {:waiting, for_sale} -> %>
          <div class="pb-bid-empty" id="pb-offers-bid-waiting">
            <.bid_icon kind={:clock} />
            <p>Opens when slot {for_sale} is taken</p>
            <p class="patchbay-muted">One slot is for sale at a time.</p>
            <.link patch={bid_path(@site, for_sale)} class="rg-button rg-button--secondary">Bid for slot {for_sale}
            <.bid_icon kind={:arrow} /></.link>
          </div>
        <% _turn -> %>
          <%= if @current_profile do %>
            <div class="pb-bid-wallet" id="pb-offers-bid-balance">
              <.bid_icon kind={:wallet} />
              <div>
                <strong>{RegentCredits.Amount.format(@balance.available)}</strong><span>available</span>
              </div>
              <span :if={Decimal.gt?(@balance.held, 0)} class="pb-bid-held">
                {RegentCredits.Amount.format(@balance.held)} held
              </span>
              <.buy_credits />
            </div>

            <div class="pb-bid-feedback" aria-live="polite">
              <p :if={@problem} class="pb-offmod-problem" role="alert" id="pb-offers-bid-problem">
                {@problem} <.buy_credits :if={@short?} />
              </p>
            </div>

            <%= if Enum.any?(@wordings, & &1.eligible?) do %>
              <.form
                for={%{}}
                as={:bid}
                id="pb-offers-bid-form"
                phx-change="change"
                phx-submit="bid"
                class="pb-offers-form"
              >
                <fieldset class="pb-bid-timing">
                  <legend>When</legend>
                  <div class="pb-bid-timing-options">
                    <label>
                      <input
                        type="radio"
                        name="bid[lane]"
                        value="immediate"
                        checked={@lane == :immediate}
                      />
                      <.bid_icon kind={:bolt} />
                      <span>{if @showing, do: "Replace now", else: "Start now"}</span>
                    </label>
                    <label :if={@showing}>
                      <input
                        type="radio"
                        name="bid[lane]"
                        value="next_period"
                        checked={@lane == :next_period}
                      />
                      <.bid_icon kind={:clock} /> <span>Next 72h</span>
                    </label>
                  </div>
                </fieldset>

                <fieldset class="pb-bid-offer-picker">
                  <legend>Choose your Offer <span aria-hidden="true">↔</span></legend>
                  <div class="pb-bid-offer-rail" role="group" aria-label="Approved Offers">
                    <label
                      :for={wording <- Enum.filter(@wordings, & &1.eligible?)}
                      class="pb-bid-offer-option"
                    >
                      <input
                        type="radio"
                        name="bid[version_id]"
                        value={wording.version.id}
                        checked={@version_id == wording.version.id}
                      />
                      <span class="pb-bid-offer-heading"><strong>{wording.creative.label}</strong><.bid_icon kind={
                        :check
                      } /></span>
                      <span class="pb-bid-offer-copy">{wording.version.text}</span>
                    </label>
                  </div>
                </fieldset>

                <Regent.Primitives.field
                  :let={field}
                  id="pb-offers-bid-amount"
                  label="Bid in Credits"
                  class="pb-bid-amount"
                >
                  <input
                    id={field.id}
                    type="text"
                    name="bid[amount]"
                    value={@amount}
                    inputmode="decimal"
                    autocomplete="off"
                    required
                    aria-describedby={field.described_by}
                  />
                  <:hint>Minimum {credits(@minimum)}</:hint>
                </Regent.Primitives.field>

                <div class="pb-bid-submit">
                  <Regent.Primitives.button
                    type="submit"
                    class="patchbay-button"
                  >
                    <span class="pb-action-label" data-press-label>Bid &amp; hold Credits
                    <.bid_icon kind={:arrow} /></span>
                  </Regent.Primitives.button>
                  <p id="pb-offers-bid-hold">{held_words(@amount)}</p>
                </div>

                <details class="pb-bid-details" id="pb-offers-bid-terms">
                  <summary><.bid_icon kind={:info} /> Bid terms</summary>
                  <div class="pb-bid-terms-body">
                    <div
                      :if={@terms.next_period}
                      class="pb-offers-lane-terms"
                      data-unused={@lane != :next_period}
                      inert={@lane != :next_period}
                    >
                      <p>{@terms.next_period}</p>
                    </div>
                    <div
                      class="pb-offers-lane-terms"
                      data-unused={@lane != :immediate}
                      inert={@lane != :immediate}
                    >
                      <p :for={line <- @terms.immediate}>{line}</p>
                    </div>
                  </div>
                </details>
              </.form>
            <% end %>

            <%= if !Enum.any?(@wordings, & &1.eligible?) do %>
              <div class="pb-bid-empty">
                <.bid_icon kind={:edit} />
                <p id="pb-offers-bid-none">
                  {if @wordings == [],
                    do: "Write an Offer to begin.",
                    else: "No Offers are approved for this market."}
                </p>
                <p class="patchbay-muted">An approved Offer unlocks bidding.</p>
                <.link navigate={~p"/offers/create"} class="rg-button rg-button--secondary">Write an Offer
                <.bid_icon kind={:arrow} /></.link>
                <Regent.Primitives.button
                  type="button"
                  disabled
                  aria-describedby="pb-offers-bid-none"
                >Bid · approval needed</Regent.Primitives.button>
              </div>
            <% end %>

            <p :if={@screening_paused?} class="pb-bid-paused" role="status">
              <.bid_icon kind={:clock} /> Screening paused in this preview
              <Regent.Primitives.tip id="pb-bid-paused-info" label="About paused screening">
                Saved Offers wait until automatic screening resumes. Waiting for approval holds no Credits.
              </Regent.Primitives.tip>
            </p>

            <details
              :if={Enum.any?(@wordings, &(!&1.eligible?))}
              class="pb-bid-details pb-offers-waiting"
            >
              <summary>
                Unavailable Offers <span>{Enum.count(@wordings, &(!&1.eligible?))}</span>
              </summary>
              <ul class="pb-offers-standing">
                <li :for={wording <- Enum.reject(@wordings, & &1.eligible?)}>
                  <strong>{wording.creative.label}</strong>
                  <p>Safety: {safety_words(wording)}</p>
                  <%= cond do %>
                    <% fit_words(wording) -> %>
                      <p>Site fit: {fit_words(wording)}</p>
                    <% @site && safety_approved?(wording) -> %>
                      <Regent.Primitives.button
                        variant="quiet"
                        phx-click="ask_fit"
                        phx-value-version_id={wording.version.id}
                      >
                        Check site fit <.bid_icon kind={:arrow} />
                      </Regent.Primitives.button>
                    <% @site -> %>
                      <p class="patchbay-muted">Safety approval first, then site fit.</p>
                    <% true -> %>
                      <p class="patchbay-muted">Safety approval needed.</p>
                  <% end %>
                </li>
              </ul>
            </details>
          <% else %>
            <div class="pb-bid-empty">
              <.bid_icon kind={:wallet} />
              <p>Sign in to bid</p>
              <p class="patchbay-muted">Use the account button at the top of the page.</p>
            </div>
          <% end %>
      <% end %>
    </Regent.Structure.panel>

    <Regent.Structure.panel
      :if={@current_profile && @bids != []}
      class="pb-bid-card pb-bid-activity"
      role="region"
      aria-labelledby="pb-offers-bid-mine"
    >
      <header class="pb-bid-card-head">
        <h2 id="pb-offers-bid-mine">Your activity</h2><.bid_icon kind={:chart} />
      </header>
      <ol id="pb-offers-bid-mine-list" class="pb-bid-activity-list">
        <li :for={bid <- @bids} id={"pb-offers-bid-#{bid.id}"}>
          <div class="pb-bid-activity-summary">
            <strong>{credits(bid.amount_minor)}</strong>
            <span class="pb-bid-activity-lane">{if bid.lane == :next_period,
              do: "Next period",
              else: "Now"}</span>
            <span class="pb-bid-state" data-state={bid.status}>{bid_state(bid.status)}</span>
          </div>
          <details class="pb-bid-details">
            <summary>Details</summary>
            <p>{standing(bid)}</p><p class="patchbay-muted">{bid.version.text}</p>
          </details>
        </li>
      </ol>
    </Regent.Structure.panel>
  </div>

  <dialog
    :if={@outbid?}
    id="pb-offers-outbid"
    class="pb-offers-result"
    role="alertdialog"
    aria-labelledby="pb-offers-outbid-title"
    phx-hook="PatchbayOfferResultDialog"
    phx-mounted={JS.ignore_attributes("open")}
  >
    <h2 id="pb-offers-outbid-title">You were outbid and Credits are returned</h2>
    <form method="dialog">
      <Regent.Primitives.button type="submit" autofocus><span
        class="pb-action-label"
        data-press-label
      >OK</span></Regent.Primitives.button>
    </form>
  </dialog>
</main>
