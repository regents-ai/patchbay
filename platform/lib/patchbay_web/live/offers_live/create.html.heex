<main class="patchbay-shell patchbay-board pb-offers" id="pb-offers-create">
  <.offers_header current={:write} signed_in={@current_profile != nil} />
  <.editor
    current_profile={@current_profile}
    screening_paused?={@screening_paused?}
    problem={@problem}
    name_problems={@name_problems}
    text_left?={@text_left?}
    new_offer={@new_offer}
    new_check={@new_check}
    saved={@saved}
    rewording={@rewording}
    deleting={@deleting}
  />
</main>
