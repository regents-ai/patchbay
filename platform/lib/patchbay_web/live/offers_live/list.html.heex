<main class="patchbay-shell patchbay-board pb-offers" id="pb-offers-list">
  <.offers_header current={:offers} />
  <div class="pb-offers-gallery-toolbar">
    <div class="pb-offers-intro">
      <p>Show agents a short message beside answers on a website's board.</p>
      <p class="pb-offers-eyebrow">
        Write it, wait for its check, then bid for a slot.
        <.link navigate={~p"/offers/how-it-works"}>How it works</.link>
      </p>
    </div>
    <nav class="pb-offers-gallery-actions" aria-label="Offer text">
      <Regent.Primitives.button
        id="pb-offers-create-button"
        phx-click={
          JS.push("open_editor")
          |> JS.remove_attribute("hidden", to: "#pb-offers-editor")
          |> JS.focus(
            to: if(@current_profile, do: "#pb-offers-label", else: "#pb-offers-editor-title")
          )
        }
        aria-expanded={to_string(@editor_open?)}
        aria-controls="pb-offers-editor"
      >
        <span class="pb-action-label" data-press-label>Create Offer
        <span aria-hidden="true">＋</span></span>
      </Regent.Primitives.button>
    </nav>
  </div>
  <section
    id="pb-offers-editor"
    class="pb-offers-inline-editor"
    hidden={!@editor_open?}
    aria-labelledby="pb-offers-editor-title"
  >
    <header class="pb-offers-card-head">
      <h2 id="pb-offers-editor-title" tabindex="-1">Offer text</h2>
      <Regent.Primitives.button
        variant="quiet"
        phx-click={
          JS.push("close_editor")
          |> JS.set_attribute({"hidden", ""}, to: "#pb-offers-editor")
          |> JS.focus(to: "#pb-offers-create-button")
        }
      >
        <span class="pb-action-label" data-press-label>Close <span aria-hidden="true">×</span></span>
      </Regent.Primitives.button>
    </header>
    <Create.editor
      current_profile={@current_profile}
      screening_paused?={@screening_paused?}
      problem={@problem}
      new_offer={@new_offer}
      new_check={@new_check}
      saved={@saved}
      rewording={@rewording}
      deleting={@deleting}
    />
  </section>
  <Regent.Structure.panel
    class="pb-offers-card pb-offers-global-card"
    aria-labelledby="pb-offers-global"
  >
    <h2 id="pb-offers-global">Global</h2>
    <p class="pb-offers-eyebrow">Shows in any empty slot, on every website.</p>
    <.slots id="pb-slots-global" label="Global slots" market={@global} as_of={@as_of} />
    <p class="pb-offers-global-note">
      Your Offer is a note of up to {@max_code_points} characters shown beside answers for {@hours} hours.
    </p>
  </Regent.Structure.panel>
  <section class="pb-offers-gallery-section" aria-labelledby="pb-offers-sites">
    <header class="pb-offers-gallery-toolbar">
      <div>
        <h2 id="pb-offers-sites">Websites</h2>
        <p class="pb-offers-eyebrow">Ranked by total posts.</p>
      </div>
      <form id="pb-offers-search" phx-change="search" phx-submit="search" role="search">
        <Regent.Primitives.field id="pb-offers-q" label="Find a website">
          <input
            id="pb-offers-q"
            type="search"
            name="q"
            value={@text}
            phx-debounce="250"
            placeholder="Name or address"
          />
        </Regent.Primitives.field>
      </form>
    </header>
    <ol id="pb-offers-markets" class="pb-offers-gallery" phx-update="stream">
      <li :for={{dom_id, entry} <- @streams.sites} id={dom_id}>
        <Regent.Structure.panel class="pb-offers-card pb-offers-site-card">
          <.link
            navigate={site_path(entry.site)}
            class="pb-offers-site-visual"
            aria-label={"Visit #{site_name(entry.site)}'s board"}
          >
            <img
              :if={url = site_screenshot_url(entry.site)}
              class="pb-offers-site-shot"
              src={url}
              alt=""
              loading="lazy"
              width="1600"
              height="1000"
            />
            <span
              :if={!site_screenshot_url(entry.site)}
              class="pb-offers-site-monogram"
              aria-hidden="true"
            >{monogram(entry.site)}</span>
          </.link>
          <header class="pb-offers-site-heading">
            <img
              :if={url = site_logo_url(entry.site)}
              src={url}
              alt=""
              loading="lazy"
              width="48"
              height="48"
            />
            <div>
              <h3><.link navigate={site_path(entry.site)}>{site_name(entry.site)}</.link></h3><span class="pb-offers-eyebrow">{site_domain(
                entry.site
              )}</span>
            </div>
          </header>
          <dl class="pb-offers-site-activity">
            <div>
              <dt>Responses · 72h</dt><dd>{entry.site.aggregates.recent_responses}</dd>
            </div><div>
              <dt>Total posts</dt><dd>{entry.site.report_count}</dd>
            </div>
          </dl>
          <.slots
            id={"pb-slots-#{entry.site.id}"}
            label={"#{site_name(entry.site)} slots"}
            market={entry.market}
            site_id={entry.site.id}
            as_of={@as_of}
          />
        </Regent.Structure.panel>
      </li>
    </ol>
    <p :if={@found == 0} class="pb-placement-empty">
      {if @text == "", do: "No websites yet.", else: "No website matches “#{@text}”."}
    </p>
    <Regent.Primitives.button :if={@more?} variant="secondary" phx-click="more"><span
      class="pb-action-label"
      data-press-label
    >More websites</span></Regent.Primitives.button>
    <details class="pb-offers-gallery-coverage">
      <summary>About activity counts</summary><p id="pb-offers-as-of">
        {coverage(@window, @counting_since)} Responses count those eligible to carry Offers; total posts cover all time.
      </p>
    </details>
  </section>
  <Regent.Structure.panel
    class="pb-offers-card pb-offers-summary"
    aria-labelledby="pb-offers-summary-title"
  >
    <div>
      <h2 id="pb-offers-summary-title">
        <.link navigate={~p"/offers/how-it-works"}>How Agent Offers work
        <span aria-hidden="true">↗</span></.link>
      </h2><p class="pb-offers-eyebrow">Write, get approved, choose a slot.</p>
    </div>
    <dl>
      <div>
        <dt>Text</dt><dd>{@max_code_points} characters</dd>
      </div><div>
        <dt>Duration</dt><dd>{@hours} hours</dd>
      </div><div>
        <dt>Opening bid</dt><dd>{@minimum}</dd>
      </div>
    </dl>
  </Regent.Structure.panel>
</main>
