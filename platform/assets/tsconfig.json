{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "erasableSyntaxOnly": true,
    "types": [
      "@webgpu/types"
    ],
    "noEmit": true,
    "paths": {
      "phoenix_live_view": [
        "../deps/phoenix_live_view"
      ]
    }
  },
  "include": [
    "js/**/*.ts",
    "js/**/*.tsx",
    "../dev/assets/**/*.ts",
    "vendor/**/*.d.ts",
    "vendor/**/*.d.mts"
  ]
}
