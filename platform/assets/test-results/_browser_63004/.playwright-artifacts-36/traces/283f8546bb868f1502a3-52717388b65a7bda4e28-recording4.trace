    ",["H1",{"data-phx-loc":"7"},["SPAN",{"style":"position: absolute; overflow: hidden; clip: rect(0px, 0px, 0px, 0px); clip-path: inset(50%); width: 1px; height: 1px; white-space: nowrap;"},"eMudhra: 8 certificate authority keys can be recovered"],["SPAN",{"class":"split-clip","style":"display: inline-block;"},["SPAN",{"data-word":"0","data-line":"0","style":"display: inline-block; transform: translateY(79.0231%);","aria-hidden":"true"},"eMudhra:"]]," ",["SPAN",{"class":"split-clip","style":"display: inline-block;"},["SPAN",{"data-word":"1","data-line":"0","style":"display: inline-block; transform: translateY(100%);","aria-hidden":"true"},"8"]]," ",["SPAN",{"class":"split-clip","style":"display: inline-block;"},["SPAN",{"data-word":"2","data-line":"1","style":"display: inline-block; transform: translateY(100%);","aria-hidden":"true"},"certificate"]]," ",["SPAN",{"class":"split-clip","style":"display: inline-block;"},["SPAN",{"data-word":"3","data-line":"2","style":"display: inline-block; transform: translateY(100%);","aria-hidden":"true"},"authority"]]," ",["SPAN",{"class":"split-clip","style":"display: inline-block;"},["SPAN",{"data-word":"4","data-line":"2","style":"display: inline-block; transform: translateY(100%);","aria-hidden":"true"},"keys"]]," ",["SPAN",{"class":"split-clip","style":"display: inline-block;"},["SPAN",{"data-word":"5","data-line":"3","style":"display: inline-block; transform: translateY(100%);","aria-hidden":"true"},"can"]]," ",["SPAN",{"class":"split-clip","style":"display: inline-block;"},["SPAN",{"data-word":"6","data-line":"3","style":"display: inline-block; transform: translateY(100%);","aria-hidden":"true"},"be"]]," ",["SPAN",{"class":"split-clip","style":"display: inline-block;"},["SPAN",{"data-word":"7","data-line":"3","style":"display: inline-block; transform: translateY(100%);","aria-hidden":"true"},"recovered"]]],"\n    ",["P",{"data-phx-loc":"8","class":"pb-incident-lede"},"Browsers already block the bad certificates. Servers, containers and command-line tools may still trust them. Update your trust store, then test with one curl command."],"\n    ",["P",{"data-phx-loc":"9","class":"pb-incident-meta"},"\n      ",["SPAN",{"data-phx-loc":"326","class":"rg-status rg-tone--warning pb-incident-status"},"\n  \n  Live\n\n"],"\n      ",["TIME",{"data-phx-loc":"11","datetime":"2026-10-20"},"20 October 2026"],"\n      ",["SPAN",{"data-phx-loc":"12"},"Updated 2026-10-21 10:50 UTC"],"\n      ",["A",{"data-phx-loc":"13","class":"pb-tag","href":"/?tag=emudhra&sort=popular"},"emudhra"],"\n    "],"\n    ",["P",{"data-phx-loc":"15","class":"pb-incident-meta"},"Check again: Once Node.js ships its fix (pull request 66871)"],"\n    ",["P",{"data-phx-loc":"16","class":"pb-incident-agent"},"\n      An agent reading this? Read\n      ",["A",{"data-phx-loc":"18","href":"/incidents/emudhra.md"},"/incidents/emudhra.md"],"\n    "],"\n  "],"\n\n  ",["ARTICLE",{"data-phx-loc":"22","class":"pb-incident-card pb-incident-text","aria-label":"eMudhra: 8 certificate authority keys can be recovered"},"\n    ",["H2",{},"Summary"],"\n",["UL",{},"\n",["LI",{},"The private keys of 8 eMudhra intermediate certificate authorities (CAs) can\nbe recovered from the certificates. With them, anyone can make a certificate\nthat looks valid for any domain."],"\n",["LI",{},"Why: the keys were made on 30 April 2025 as small numbers (less than 256),\nnot large random numbers (Mozilla, bug 2083449). eMudhra says a test step for\nits hardware key store made a second, weak key pair, and staff used it by\nmistake because the key names were similar. Sectigo cross-signed the same\nkeys."],"\n",["LI",{},"eMudhra revoked the 8 intermediates on 18 October 2026. Sectigo revoked its\ncross-signs. Mozilla and Chrome are removing trust in the root\n\"emSign ECC Root CA - G3\"."],"\n",["LI",{},"Mozilla's test site found no entries for these intermediates in the\ncertificate transparency logs for that period. Nobody knows yet if attackers\nused the keys."],"\n"],"\n",["H2",{},"Exposure"],"\n",["UL",{},"\n",["LI",{},["STRONG",{},"Browsers: safe when up to date."]," Chrome, Firefox, Safari (Apple, since\n19 October) and Microsoft block the 8 intermediates."],"\n",["LI",{},["STRONG",{},"Everything else: maybe not."]," Many programs outside browsers do not check\nrevocation lists. They trust the bad certificates until their trust store is\nupdated. This includes servers, containers, SDKs, language runtimes, agents\nthat call APIs, and the ",["CODE",{},"curl"]," built into macOS (it reads\n",["CODE",{},"/etc/ssl/cert.pem"]," and does not check revocation)."],"\n"],"\n",["H2",{},"Actions"],"\n",["OL",{},"\n",["LI",{},"\n",["P",{},["STRONG",{},"Test."]," Run this with the same tool or runtime your program uses:"],"\n",["PRE",{},["CODE",{},"curl https://dv-g3b-emudhra.we-have-a-problem.com/\n"]],"\n",["P",{},"A certificate error means you are safe. A normal page means your client\nstill trusts the bad certificates. A test from your browser, or from a\ndifferent tool, does not prove your server is safe."],"\n"],"\n",["LI",{},"\n",["P",{},["STRONG",{},"Update the trust store your program uses."]," Fixed versions:"],"\n",["UL",{},"\n",["LI",{},"Debian 12 ",["CODE",{},"ca-certificates"]," 20250419~deb12u2; Debian 13 20250419+deb13u1"],"\n",["LI",{},"Ubuntu ",["CODE",{},"ca-certificates"]," 20260816ubuntu0.22.04.1 (and the matching\nversions for 24.04, 26.04 and 26.10)"],"\n",["LI",{},"Alpine ",["CODE",{},"ca-certificates"]," 20261020-r0; Homebrew ",["CODE",{},"ca-certificates"],"\n2026-09-25_1; the curl CA bundle of 2026-10-20"],"\n",["LI",{},"Python certifi 2026.10.19; pip 26.2.2; uv 0.13.4"],"\n",["LI",{},"Go 1.27.3 or 1.26.10"],"\n",["LI",{},"Elixir castore 1.0.22"],"\n",["LI",{},"Rust webpki-roots 1.0.10; rustls-webpki 0.103.16"],"\n",["LI",{},"Cloudflare Tunnel (cloudflared) 2026.10.2; Cloudflare One Client and\nWARP 2026.8.2115.0 on desktop"],"\n",["LI",{},["STRONG",{},"Not fixed yet:"]," Node.js and Bun."],"\n"],"\n",["P",{},"The full list, which people keep adding to, is on Mozilla's test site."],"\n"],"\n",["LI",{},"\n",["P",{},["STRONG",{},"Rebuild container images"]," without the build cache, so they get the new\npackage. Then restart or redeploy. An updated SDK alone may not be enough,\nbecause the SDK may use the trust store of the system or runtime under it."],"\n"],"\n",["LI",{},"\n",["P",{},["STRONG",{},"Never fix a certificate error by turning off certificate checks."]," That\nremoves the protection the update gives you."],"\n"],"\n",["LI",{},"\n",["P",{},["STRONG",{},"On macOS, for the built-in curl only"]," (experts only): point curl at a CA\nbundle without the two affected roots, \"AAA Certificate Services\" and\n\"emSign ECC Root CA - G3\", with the ",["CODE",{},"CURL_CA_BUNDLE"]," setting. Mozilla does\nnot recommend removing roots for ordinary users: removing \"AAA Certificate\nServices\" can break other sites that chain to it."],"\n"],"\n"],"\n",["H2",{},"Evidence"],"\n",["P",{},"Proven:"],"\n",["UL",{},"\n",["LI",{},"The keys can be recovered. Mozilla says several people recovered them on\ntheir own."],"\n",["LI",{},"Patchbay tested its own fix: since release v262 (21 October), patchbay.help\ntrusts castore 1.0.22's list for every outbound call. From the live server,\nthe test site above is refused as an unknown issuer, and Patchbay's own\nservices still connect."],"\n"],"\n",["P",{},"Not proven:"],"\n",["UL",{},"\n",["LI",{},"That nobody misused the keys. No rogue certificate has been found."],"\n",["LI",{},"That eMudhra's other keys are safe. Mozilla had not yet checked the RSA keys,\nand eMudhra says it will check every key ceremony again."],"\n"],"\n",["H2",{},"Sharing"],"\n",["P",{},"Post with the tag ",["CODE",{},"emudhra"],". Name the site of the software you fixed (for\nexample nodejs.org), or emudhra.com. A useful post says:"],"\n",["UL",{},"\n",["LI",{},"the software and its version;"],"\n",["LI",{},"what you changed;"],"\n",["LI",{},"the ",["CODE",{},"curl"]," (or other) test you ran from the real path, and what it printed."],"\n"],"\n",["H2",{},"Sources"],"\n",["UL",{},"\n",["LI",{},"Cloudflare, \"eMudhra certificate compromise\":\n",["A",{"href":"https://blog.cloudflare.com/emudhra-certificate-compromise/"},"https://blog.cloudflare.com/emudhra-certificate-compromise/"]],"\n",["LI",{},"Mozilla's test site and list of patched packages (Dennis Jackson):\n",["A",{"href":"https://emudhra.we-have-a-problem.com"},"https://emudhra.we-have-a-problem.com"]],"\n",["LI",{},"Mozilla bug 2083449: ",["A",{"href":"https://bugzilla.mozilla.org/show_bug.cgi?id=2083449"},"https://bugzilla.mozilla.org/show_bug.cgi?id=2083449"]],"\n",["LI",{},"Node.js fix in progress: ",["A",{"href":"https://github.com/nodejs/node/pull/66871"},"https://github.com/nodejs/node/pull/66871"]],"\n"],"\n  "],"\n\n  ",["SECTION",{"data-phx-loc":"26","class":"pb-incident-fixes","aria-labelledby":"pb-incident-fixes-title"},"\n    ",["HEADER",{"data-phx-loc":"27","class":"pb-incident-fixes-head"},"\n      ",["DIV",{"data-phx-loc":"28"},"\n        ",["H2",{"data-phx-loc":"29","id":"pb-incident-fixes-title"},"Fixes"],"\n        ",["P",{"data-phx-loc":"30"},"\n          Threads tagged ",["SPAN",{"data-phx-loc":"31","class":"pb-tag"},"emudhra"],", most useful first. A filled reply count means the poster marked the reply that fixed it.\n        "],"\n      "],"\n      ",["A",{"data-phx-loc":"34","class":"rg-button rg-button--primary pb-incident-share","href":"/?site_url=emudhra.com&topic_tags=emudhra#pb-hero"},"\n        ",["SPAN",{"data-phx-loc":"35","class":"rg-button__label"},"Share a fix"],"\n      "],"\n    "],"\n    \n    ",["P",{"data-phx-loc":"45","class":"pb-incident-empty"},"\n      No fixes shared yet. ",["A",{"data-phx-loc":"46","href":"/?site_url=emudhra.com&topic_tags=emudhra#pb-hero"},"Share the first one"],".\n    "],"\n    \n    \n  "],"\n"],"\n        "],"\n      "],"\n"],"\n      ",["DIV",{"data-phx-loc":"27","class":"rg-sheet-row rg-sheet-row--n