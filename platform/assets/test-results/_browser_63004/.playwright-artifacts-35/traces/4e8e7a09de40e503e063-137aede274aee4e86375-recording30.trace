st"},"\n          ",["H3",{"data-phx-loc":"21"},"New wallet"],"\n          \n          ",["P",{"data-phx-loc":"23"},"Listed once this test has run."],"\n        "],["DIV",{"data-phx-loc":"20","class":"pb-wb-check-test"},"\n          ",["H3",{"data-phx-loc":"21"},"Refund"],"\n          \n          ",["P",{"data-phx-loc":"23"},"Listed once this test has run."],"\n        "],["DIV",{"data-phx-loc":"20","class":"pb-wb-check-test"},"\n          ",["H3",{"data-phx-loc":"21"},"Paid call"],"\n          \n          ",["P",{"data-phx-loc":"23"},"Listed once this test has run."],"\n        "],["DIV",{"data-phx-loc":"20","class":"pb-wb-check-test"},"\n          ",["H3",{"data-phx-loc":"21"},"Patchbay sign-in"],"\n          \n          ",["P",{"data-phx-loc":"23"},"Listed once this test has run."],"\n        "],"\n      "],"\n      ",["ARTICLE",{"data-phx-loc":"26","class":"pb-wb-card","aria-labelledby":"pb-wb-meanings-title"},"\n        ",["H2",{"data-phx-loc":"27","id":"pb-wb-meanings-title"},"Results"],"\n        ",["DL",{"data-phx-loc":"28","class":"pb-wb-meanings"},"\n          ",["DIV",{"data-phx-loc":"29"},"\n            ",["DT",{"data-phx-loc":"30"},["SPAN",{"data-phx-loc":"405","class":"pb-wb-chip is-pass"},"PASS"]],"\n            ",["DD",{"data-phx-loc":"31"},"PASS: Techtree's word for this result."],"\n          "],["DIV",{"data-phx-loc":"29"},"\n            ",["DT",{"data-phx-loc":"30"},["SPAN",{"data-phx-loc":"405","class":"pb-wb-chip is-flagged"},"PASS*"]],"\n            ",["DD",{"data-phx-loc":"31"},"PASS*: Techtree's word for this result."],"\n          "],["DIV",{"data-phx-loc":"29"},"\n            ",["DT",{"data-phx-loc":"30"},["SPAN",{"data-phx-loc":"405","class":"pb-wb-chip is-failed"},"FAILED_TECHNICAL"]],"\n            ",["DD",{"data-phx-loc":"31"},"FAILED_TECHNICAL: Techtree's word for this result."],"\n          "],["DIV",{"data-phx-loc":"29"},"\n            ",["DT",{"data-phx-loc":"30"},["SPAN",{"data-phx-loc":"405","class":"pb-wb-chip is-unsafe"},"FAILE