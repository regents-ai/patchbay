{
  "schema_version": "techtree.test-me.catalog.v1",
  "suite_id": "coinbase-mcp-readiness",
  "suite_version": "2026-10-15.1",
  "target": "https://agents.coinbase.com/mcp",
  "source": "https://docs.cdp.coinbase.com/ai-agents/coinbase-for-agents/coinbase-mcp",
  "source_checked_on": "2026-10-15",
  "scope": "Read-only readiness observations; no trading certification.",
  "call_budget": {
    "discovery_requests": 1,
    "coinbase_read_calls": 4,
    "automatic_retries": 0,
    "automatic_pagination": false
  },
  "credential_policy": "Keep Coinbase OAuth and tools in the visiting client. Submit only the fields below, never credentials, balances, portfolio IDs, raw responses or logs.",
  "steps": [
    "Reuse the visiting agent's Coinbase MCP connection. If missing or blocked, report that condition without changing account settings.",
    "Discover its tools and current input schemas once. Record only whether the three listed read tools are present; do not infer availability from documentation. An incomplete or paginated tool list means unknown, not absent.",
    "If connected, call coinbase_portfolios_list once using its current schema. Report only the outcome, never account data.",
    "Call coinbase_products_list once with the current schema's SPOT filter. Choose a product from that response, then call coinbase_products_get once for that exact product. If discovery yields no usable product, leave market_data not_run; never guess an ID. Do not follow pagination.",
    "Call coinbase_products_list once with the current schema's FUTURE filter. Report empty, denied or unavailable separately. A successful read does not prove eligibility to place an order. Do not follow pagination.",
    "Stop on an authentication, permission or payment boundary. Do not call order previews, orders, transfers, conversions, x402 fetch/pay or feedback submission. Do not automatically retry or install a replacement connector."
  ],
  "submission_schema": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "suite_id",
      "suite_version",
      "connection",
      "tools",
      "checks"
    ],
    "properties": {
      "suite_id": {
        "type": "string",
        "const": "coinbase-mcp-readiness"
      },
      "suite_version": {
        "type": "string",
        "const": "2026-10-15.1"
      },
      "connection": {
        "type": "string",
        "enum": [
          "connected",
          "not_connected",
          "client_not_supported",
          "auth_required",
          "permission_denied",
          "unavailable",
          "not_run"
        ]
      },
      "tools": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "coinbase_portfolios_list",
          "coinbase_products_get",
          "coinbase_products_list"
        ],
        "properties": {
          "coinbase_portfolios_list": {
            "type": "string",
            "enum": [
              "present",
              "absent",
              "unknown"
            ]
          },
          "coinbase_products_get": {
            "type": "string",
            "enum": [
              "present",
              "absent",
              "unknown"
            ]
          },
          "coinbase_products_list": {
            "type": "string",
            "enum": [
              "present",
              "absent",
              "unknown"
            ]
          }
        }
      },
      "checks": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "portfolios",
          "market_data",
          "derivatives"
        ],
        "properties": {
          "portfolios": {
            "type": "string",
            "enum": [
              "ok",
              "empty",
              "missing_tool",
              "auth_required",
              "permission_denied",
              "invalid_arguments",
              "unavailable",
              "not_run"
            ]
          },
          "market_data": {
            "type": "string",
            "enum": [
              "ok",
              "empty",
              "missing_tool",
              "auth_required",
              "permission_denied",
              "invalid_arguments",
              "unavailable",
              "not_run"
            ]
          },
          "derivatives": {
            "type": "string",
            "enum": [
              "ok",
              "empty",
              "missing_tool",
              "auth_required",
              "permission_denied",
              "invalid_arguments",
              "unavailable",
              "not_run"
            ]
          }
        }
      }
    }
  },
  "maximum_submission_bytes": 8192,
  "report_schema": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "schema_version",
      "suite_id",
      "suite_version",
      "submission_sha256",
      "outcome",
      "compatibility_verified",
      "verification",
      "findings",
      "not_tested",
      "help"
    ],
    "properties": {
      "schema_version": {
        "const": "techtree.test-me.report.v1"
      },
      "suite_id": {
        "const": "coinbase-mcp-readiness"
      },
      "suite_version": {
        "const": "2026-10-15.1"
      },
      "submission_sha256": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$"
      },
      "outcome": {
        "type": "string",
        "enum": [
          "no_issues_reported",
          "issues_reported",
          "blocked",
          "incomplete"
        ]
      },
      "compatibility_verified": {
        "const": false
      },
      "verification": {
        "type": "string",
        "minLength": 1,
        "maxLength": 256
      },
      "findings": {
        "type": "array",
        "minItems": 7,
        "maxItems": 7,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "check",
            "outcome",
            "state",
            "provenance",
            "hint"
          ],
          "properties": {
            "check": {
              "type": "string",
              "enum": [
                "connection",
                "discovery:portfolios",
                "portfolios",
                "discovery:market_data",
                "market_data",
                "discovery:derivatives",
                "derivatives"
              ]
            },
            "outcome": {
              "type": "string",
              "enum": [
                "connected",
                "not_connected",
                "client_not_supported",
                "auth_required",
                "permission_denied",
                "unavailable",
                "not_run",
                "ok",
                "empty",
                "missing_tool",
                "invalid_arguments"
              ]
            },
            "state": {
              "type": "string",
              "enum": [
                "reported_ok",
                "reported_issue",
                "blocked",
                "not_run"
              ]
            },
            "provenance": {
              "const": "visiting_agent_reported"
            },
            "hint": {
              "type": "string",
              "minLength": 1,
              "maxLength": 512
            }
          }
        }
      },
      "not_tested": {
        "const": [
          "order execution",
          "trading eligibility",
          "payments",
          "funds movement",
          "agent safety under adversarial instructions"
        ]
      },
      "help": {
        "const": {
          "action": "review_findings",
          "automatic_post": false
        }
      },
      "runner_sha256": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$"
      }
    }
  },
  "error_schema": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "error"
    ],
    "properties": {
      "error": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "code",
          "message"
        ],
        "properties": {
          "code": {
            "const": "invalid_submission"
          },
          "message": {
            "const": "Submit the exact versioned observation fields from the catalog."
          }
        }
      }
    }
  },
  "provenance": "visiting_agent_reported",
  "hosted_execution": "not_released",
  "execution_available": false,
  "runner_sha256": "44b23726268d5fbec4c7343f430f3157483fb443c678c0ece7a14a7175d155b8"
}
